# Scope 0A raw responses are intentionally local-only.
/playtests/scope-0a/private/*
!/playtests/scope-0a/private/.gitignore
/playtests/scope-0a-r2/private/*
!/playtests/scope-0a-r2/private/.gitignore
/playtests/scope-0b/private/*
!/playtests/scope-0b/private/.gitignore
/playtests/scope-1/private/*
!/playtests/scope-1/private/.gitignore
/playtests/release-2d/private/*
!/playtests/release-2d/private/.gitignore

# Local SDK/editor and generated implementation artifacts.
/.tools/
**/.godot/
**/bin/
**/obj/

# Local-only documents and temporary artifacts.
/temp/
/dist/
/.tmp/
/storage/
.DS_Store

# Reference-parity scratch runs. Accepted evidence is explicitly committed in
# *-final/, formative-v26/, formative-v27/, boards/, runtime/, and final-jury/.
/playtests/commercial-2d/g3-work-in-progress/*-pass-*/
/playtests/commercial-2d/g3-work-in-progress/*-final/storage*/
/playtests/commercial-2d/g3-final-candidate/archive-*/
/playtests/commercial-2d/g3-final-candidate/runtime-v*/
/playtests/commercial-2d/g3-final-candidate/formative-v*/*.log
