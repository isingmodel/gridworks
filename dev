#!/bin/zsh

set -euo pipefail

repository_dir=${0:A:h}
godot_bin=${GRIDWORKS_GODOT_BIN:-"$repository_dir/.tools/godot-4.7.1/Godot_mono.app/Contents/MacOS/Godot"}

usage() {
    print -u2 -- "usage: ./dev build"
    print -u2 -- "       ./dev check"
    print -u2 -- "       ./dev play product"
    print -u2 -- "       ./dev play layout"
    print -u2 -- "       ./dev play fixture"
    print -u2 -- "       ./dev play chapter CHAPTER_ID"
    print -u2 -- "       ./dev play through CHAPTER_ID"
    print -u2 -- "       ./dev checkpoint CHECKPOINT_ID"
    print -u2 -- "       ./dev story SELECTOR|manifest"
    print -u2 -- "       ./dev candidate build"
    print -u2 -- "       ./dev candidate verify MANIFEST"
    print -u2 -- "       ./dev qualify run MANIFEST"
    print -u2 -- "       ./dev qualify verify RECORD"
}

fail() {
    print -u2 -- "$1"
    exit 2
}

require_godot() {
    [[ -x $godot_bin ]] || fail "Godot executable not found: $godot_bin"
}

run_checkpoint() {
    local checkpoint_id=$1
    "$godot_bin" \
        --headless \
        --path "$repository_dir/game" \
        --scene res://realtime/r2/RealtimeSliceCheckpointRunner.tscn \
        -- \
        --checkpoint="$checkpoint_id"
}

run_product_entry_smoke() {
    "$godot_bin" \
        --headless \
        --path "$repository_dir/game" \
        --scene res://realtime/r2/RealtimeProductEntrySmokeRunner.tscn \
        "$@"
}

run_realtime_ui_harness() {
    "$godot_bin" \
        --headless \
        --path "$repository_dir/game" \
        --scene res://realtime/ui/RealtimeUiLayoutHarness.tscn
}

run_product_save_continue_smoke() {
    local smoke_dir
    local smoke_save
    local reset_save
    local completed_save
    local legacy_save
    local invalid_save
    local unsupported_save
    local io_failure_save
    smoke_dir=$(mktemp -d "${TMPDIR:-/tmp}/gridworks-r2-save-smoke.XXXXXX")
    smoke_save="$smoke_dir/campaign.json"
    reset_save="$smoke_dir/reset.json"
    completed_save="$smoke_dir/completed.json"
    legacy_save="$smoke_dir/legacy-first-light.json"
    invalid_save="$smoke_dir/invalid.json"
    unsupported_save="$smoke_dir/unsupported.json"
    io_failure_save="$smoke_dir/io-failure"
    run_product_entry_smoke -- "--save-create=$smoke_save"
    run_product_entry_smoke -- "--save-nonsaveable-exit=$smoke_save"
    run_product_entry_smoke -- "--save-continue=$smoke_save"
    run_product_entry_smoke -- "--save-create=$reset_save"
    run_product_entry_smoke -- "--save-continue=$reset_save"
    run_product_entry_smoke -- "--save-reset=$reset_save"
    run_product_entry_smoke -- "--save-continue=$reset_save"
    run_product_entry_smoke -- "--save-completed-create=$completed_save"
    run_product_entry_smoke -- "--save-continue=$completed_save"
    run_product_entry_smoke -- "--save-completed-new-game=$completed_save"
    run_product_entry_smoke -- "--save-continue=$completed_save"
    run_product_entry_smoke -- "--save-continue=$smoke_save"
    run_product_entry_smoke -- "--save-continue=$smoke_save"
    run_product_entry_smoke -- "--save-legacy-continue=$legacy_save"
    run_product_entry_smoke -- "--save-invalid=$invalid_save"
    run_product_entry_smoke -- "--save-unsupported=$unsupported_save"
    run_product_entry_smoke -- "--save-io-failure=$io_failure_save"
    rm -- "$smoke_save" "$reset_save" "$completed_save" "$legacy_save" "$invalid_save" "$unsupported_save"
    rmdir -- "$io_failure_save"
    rmdir -- "$smoke_dir"
}

run_product_settings_smoke() {
    local smoke_dir
    local settings_path
    local invalid_path
    local unsupported_path
    local read_failure_path
    smoke_dir=$(mktemp -d "${TMPDIR:-/tmp}/gridworks-r2-settings-smoke.XXXXXX")
    settings_path="$smoke_dir/settings.json"
    invalid_path="$smoke_dir/invalid.json"
    unsupported_path="$smoke_dir/unsupported.json"
    read_failure_path="$smoke_dir/read-failure.json"
    run_product_entry_smoke -- "--settings-create=$settings_path"
    run_product_entry_smoke -- "--settings-restore=$settings_path"
    run_product_entry_smoke -- "--settings-invalid=$invalid_path"
    run_product_entry_smoke -- "--settings-unsupported=$unsupported_path"
    run_product_entry_smoke -- "--settings-read-failure=$read_failure_path"
    rm -- "$settings_path" "$invalid_path" "$unsupported_path" "$read_failure_path"
    rmdir -- "$smoke_dir"
}

command_name=${1:-help}
if (( $# > 0 )); then
    shift
fi

cd "$repository_dir"

case $command_name in
    build)
        [[ $# -eq 0 ]] || fail "build takes no arguments."
        dotnet build "$repository_dir/Gridworks.sln" -c Debug
        ;;
    check)
        [[ $# -eq 0 ]] || fail "check takes no arguments."
        require_godot
        dotnet build "$repository_dir/Gridworks.sln" -c Debug
        dotnet run --project "$repository_dir/tools/Gridworks.RealtimeChecks" -c Release
        dotnet run --project "$repository_dir/tools/Gridworks.CommercialChecks" -c Release
        python3 "$repository_dir/tools/commercial-ux/test-realtime-text-plan-tools.py"
        python3 "$repository_dir/tools/commercial-ux/test-g3-a1-asset-allowlist.py"
        python3 "$repository_dir/tools/commercial-ux/test-realtime-default-entry.py"
        run_product_entry_smoke
        run_product_entry_smoke -- --technical-fixture
        run_product_save_continue_smoke
        run_product_settings_smoke
        run_realtime_ui_harness
        run_checkpoint A1_NORMAL_READY
        run_checkpoint A1_CONSTRUCTION_DUE_1M
        ;;
    play)
        require_godot
        [[ $# -ge 1 ]] || fail "play requires product, layout, fixture, chapter, or through."
        play_mode=$1
        shift
        dotnet build "$repository_dir/game/Gridworks.Game.csproj" -c Debug
        case $play_mode in
            product)
                [[ $# -eq 0 ]] || fail "play product takes no additional arguments."
                "$godot_bin" \
                    --path "$repository_dir/game"
                ;;
            layout)
                [[ $# -eq 0 ]] || fail "play layout takes no additional arguments."
                GRIDWORKS_VISUAL_LAYOUT_EDITOR=1 "$godot_bin" \
                    --path "$repository_dir/game" \
                    -- \
                    --release-chapter=FIRST_LIGHT
                ;;
            fixture)
                [[ $# -eq 0 ]] || fail "play fixture takes no additional arguments."
                "$godot_bin" \
                    --path "$repository_dir/game" \
                    -- \
                    --technical-fixture
                ;;
            chapter)
                [[ $# -eq 1 ]] || fail "play chapter requires exactly one chapter ID."
                "$godot_bin" \
                    --path "$repository_dir/game" \
                    -- \
                    --release-chapter="$1"
                ;;
            through)
                [[ $# -eq 1 ]] || fail "play through requires exactly one chapter ID."
                "$godot_bin" \
                    --path "$repository_dir/game" \
                    -- \
                    --release-through="$1"
                ;;
            *)
                fail "Unknown play mode: $play_mode"
                ;;
        esac
        ;;
    checkpoint)
        require_godot
        [[ $# -eq 1 ]] || fail "checkpoint requires exactly one checkpoint ID."
        dotnet build "$repository_dir/game/Gridworks.Game.csproj" -c Debug
        run_checkpoint "$1"
        ;;
    story)
        [[ $# -eq 1 ]] || fail "story requires exactly one selector or manifest."
        if [[ $1 == manifest ]]; then
            dotnet run \
                --project "$repository_dir/tools/Gridworks.CommercialChecks" \
                -c Release \
                -- \
                --story-manifest
        else
            dotnet run \
                --project "$repository_dir/tools/Gridworks.CommercialChecks" \
                -c Release \
                -- \
                --story-part "$1"
        fi
        ;;
    candidate)
        [[ $# -ge 1 ]] || fail "candidate requires build or verify MANIFEST."
        python3 "$repository_dir/tools/r2_candidate.py" "$@"
        ;;
    qualify)
        [[ $# -ge 2 ]] || fail "qualify requires run MANIFEST or verify RECORD."
        python3 "$repository_dir/tools/r2_qualification.py" "$@"
        ;;
    help|-h|--help)
        [[ $# -eq 0 ]] || fail "help takes no arguments."
        usage
        ;;
    *)
        usage
        fail "Unknown development command: $command_name"
        ;;
esac
