{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/realtime-evaluator-candidate-manifest-v1.json",
  "title": "Gridworks realtime evaluator candidate manifest",
  "$comment": "STRUCTURAL VALIDATION ONLY. AJV/schema success is never candidate authority. A consumer MUST run verify_manifest_against_reconstructed_authority so hashes, unique paths, raw streams, checkpoint cross-bindings, exact bytes, and pinned policy are independently reconstructed. candidateSha256 is SHA-256 of GRIDWORKS_CANONICAL_JSON_V1 bytes for this object with candidateSha256 omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalization",
    "policySha256",
    "sourceCommit",
    "evaluatorProducerAuthority",
    "candidateKind",
    "configuration",
    "officialCommercialUX",
    "scoreBearingCaptureAllowed",
    "sourceAuthority",
    "managedBuild",
    "engineAuthority",
    "packageAuthority",
    "headlessExecutionAuthority",
    "storyAuthority",
    "sceneAuthority",
    "routeProfiles",
    "futureEventStatusBar",
    "limitations",
    "candidateSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "gridworks.realtime-evaluator-candidate-manifest.v1"},
    "canonicalization": {"const": "GRIDWORKS_CANONICAL_JSON_V1"},
    "policySha256": {"$ref": "#/$defs/sha256"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evaluatorProducerAuthority": {"$ref": "#/$defs/evaluatorProducerAuthority"},
    "candidateKind": {"const": "EDITOR_NATIVE_NONDEFAULT_DEBUG_FIRST_LIGHT"},
    "configuration": {"const": "Debug"},
    "officialCommercialUX": {"const": false},
    "scoreBearingCaptureAllowed": {"const": false},
    "sourceAuthority": {"$ref": "#/$defs/sourceAuthority"},
    "managedBuild": {"$ref": "#/$defs/managedBuild"},
    "engineAuthority": {"$ref": "#/$defs/engineAuthority"},
    "packageAuthority": {"$ref": "#/$defs/packageAuthority"},
    "headlessExecutionAuthority": {"$ref": "#/$defs/headlessExecutionAuthority"},
    "storyAuthority": {"$ref": "#/$defs/storyAuthority"},
    "sceneAuthority": {
      "const": {
        "projectDefaultScene": "res://CommercialMain.tscn",
        "evaluationTargetScene": "res://realtime/r2/RealtimeSliceMain.tscn",
        "checkpointRunnerScene": "res://realtime/r2/RealtimeSliceCheckpointRunner.tscn",
        "evaluationTargetIsDefault": false,
        "runtimeFixtureCoverage": "FIRST_LIGHT_1_CHAPTER_3_EVENTS"
      }
    },
    "routeProfiles": {"const": [
      {
        "profileId": "INTERACTIVE_NONDEFAULT_R2",
        "routeKind": "INTERACTIVE_R2_SLICE",
        "availability": "AVAILABLE_DIAGNOSTIC_ONLY",
        "scene": "res://realtime/r2/RealtimeSliceMain.tscn",
        "sceneOverrideRequired": true,
        "arguments": [],
        "runtimeCoverage": "FIRST_LIGHT_1_CHAPTER_3_EVENTS",
        "allowedClaimPrefix": "INTERACTIVE_R2_SLICE_OBSERVATION:"
      },
      {
        "profileId": "TARGETED_CHECKPOINT_DEBUG",
        "routeKind": "TARGETED_CHECKPOINT",
        "availability": "AVAILABLE_DIAGNOSTIC_ONLY",
        "scene": "res://realtime/r2/RealtimeSliceCheckpointRunner.tscn",
        "sceneOverrideRequired": true,
        "argumentTemplate": "--checkpoint=<CANONICAL_ID>",
        "checkpoints": [
          {
            "checkpointId": "A1_NORMAL_READY",
            "startMinute": 1020,
            "startCanonicalStateSha256": "sha256:7094f631c89fe072800858a205d08358be07a6e0e7341b83026ff619fc03f9a3",
            "commandReplaySchema": "gridworks.targeted-live-command-replay.v1",
            "commandReplaySha256": "sha256:4f4d3748681585f49eeb4291262db3c99676baba10913450c94d5e1eda9e1611",
            "commandCount": 0,
            "expectedEndCanonicalStateSha256": "sha256:d61217a830053e59f9c75a69eef110da2604892baf9b52ea74cb04d406ad6fec",
            "allowedInput": "HUD_SPEED_NORMAL",
            "allowedFrameCount": 60,
            "framesPerSecond": 60,
            "claimLabel": "TARGETED_LIVE_CHECKPOINT_PASS:A1_NORMAL_READY"
          },
          {
            "checkpointId": "A1_CONSTRUCTION_DUE_1M",
            "startMinute": 1259,
            "startCanonicalStateSha256": "sha256:3a00c6c937d130cc7574e3971403445cb036a26aecba6671e300e1398d4b9989",
            "commandReplaySchema": "gridworks.targeted-live-command-replay.v1",
            "commandReplaySha256": "sha256:9bd7c3226fd36396d9d9f7a8d81da25379cedb8e0e54441601bb7c89e947c65c",
            "commandCount": 3,
            "expectedEndCanonicalStateSha256": "sha256:304b96410d7652db9928613fe77443d8d50e29efcb273ff8061c064f876f37f9",
            "allowedInput": "HUD_SPEED_NORMAL",
            "allowedFrameCount": 60,
            "framesPerSecond": 60,
            "claimLabel": "TARGETED_LIVE_CHECKPOINT_PASS:A1_CONSTRUCTION_DUE_1M"
          }
        ],
        "runtimeCoverage": "EXACT_BOUNDED_CHECKPOINT_ONLY",
        "allowedClaimPrefix": "TARGETED_LIVE_CHECKPOINT_PASS:"
      },
      {
        "profileId": "FULL_FLOW_EXCEPTION",
        "routeKind": "FULL_FLOW_EXCEPTION",
        "availability": "UNAVAILABLE_NOT_IMPLEMENTED",
        "scene": null,
        "sceneOverrideRequired": false,
        "arguments": null,
        "runtimeCoverage": "NONE",
        "allowedClaimPrefix": null,
        "requiredFreshBoundaries": [
          "DEFAULT_PACKAGE_ONBOARDING",
          "SAVE_TO_FRESH_PROCESS_RESTORE",
          "ACCUMULATED_EIGHT_CHAPTER_COMPLETION",
          "FINALE_AND_EPILOGUE"
        ],
        "forbiddenSubstitutes": [
          "SCENE_OVERRIDE",
          "FIXTURE_SEED",
          "CHECKPOINT_RUNNER",
          "TARGETED_LIVE_CHECKPOINT_PASS",
          "COMMERCIAL_MAIN_V2"
        ]
      }
    ]},
    "futureEventStatusBar": {
      "const": {
        "sourcePath": "game/realtime/ui/RealtimeEventRail.cs",
        "scenePath": "game/realtime/ui/RealtimeEventRail.tscn",
        "requiredSignals": [
          "CURRENT_TIME",
          "NEXT_EVENT_COUNTDOWN",
          "EVENT_START_END",
          "CONSTRUCTION_COMPLETION",
          "PROMISE_DECISION_DEADLINE",
          "THERMAL_TRIP_RECOVERY"
        ],
        "headlessWiringStatus": "EXACT_PACKAGE_TWO_CHECKPOINT_SCENE_LOAD_PASS",
        "nativeQualityStatus": "NOT_OBSERVED"
      }
    },
    "limitations": {"const": [
      "DEFAULT_SCENE_IS_COMMERCIAL_MAIN_V2",
      "EXPORT_RELEASE_EXCLUDES_R2_UI_AND_V3_CORE",
      "R2_RUNTIME_USES_FIRST_LIGHT_FIXTURE_NOT_FULL_RELEASE_V3",
      "FULL_CAMPAIGN_NATIVE_E2E_NOT_IMPLEMENTED",
      "SAVE_RESUME_FINALE_EPILOGUE_NATIVE_NOT_IMPLEMENTED",
      "FUTURE_EVENT_STATUS_BAR_NATIVE_QUALITY_NOT_OBSERVED",
      "MODEL_ULTRA_EXECUTION_RECEIPT_NOT_AVAILABLE",
      "HEADLESS_PROBE_USES_LOCAL_EDITOR_AND_SYSTEM_DOTNET",
      "DOTNET_TOOLCHAIN_TRANSITIVE_CLOSURE_NOT_BOUND",
      "GIT_EXECUTABLE_ONLY_TRANSITIVE_SYSTEM_DYLIB_CLOSURE_NOT_BOUND",
      "SCORE_BEARING_CAPTURE_FORBIDDEN"
    ]},
    "candidateSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])[^\\u0000]+$"
    },
    "evaluatorProducerAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "sourceCommit", "fileCount", "files", "filesSha256",
        "runningFilesMatchGitBlobs", "gitCommandAuthority", "semanticVerifierEntryPoint",
        "semanticVerifierReexecutesHeadlessProbes", "structuralSchemaAuthority"
      ],
      "properties": {
        "schemaVersion": {"const": "gridworks.realtime-evaluator-producer-authority.v1"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "fileCount": {"const": 4},
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "prefixItems": [
            {"allOf": [
              {"$ref": "#/$defs/evaluatorProducerFileRow"},
              {"type": "object", "properties": {
                "path": {"const": "tools/commercial-ux/native/build-realtime-candidate-authority.py"},
                "role": {"const": "EVALUATOR_PRODUCER_AND_SEMANTIC_VERIFIER"}
              }, "required": ["path", "role"]}
            ]},
            {"allOf": [
              {"$ref": "#/$defs/evaluatorProducerFileRow"},
              {"type": "object", "properties": {
                "path": {"const": "tools/commercial-ux/native/realtime-candidate-manifest.schema.json"},
                "role": {"const": "STRUCTURAL_SCHEMA_NON_AUTHORITY"}
              }, "required": ["path", "role"]}
            ]},
            {"allOf": [
              {"$ref": "#/$defs/evaluatorProducerFileRow"},
              {"type": "object", "properties": {
                "path": {"const": "tools/commercial-ux/native/realtime-candidate-policy.json"},
                "role": {"const": "EVALUATOR_POLICY"}
              }, "required": ["path", "role"]}
            ]},
            {"allOf": [
              {"$ref": "#/$defs/evaluatorProducerFileRow"},
              {"type": "object", "properties": {
                "path": {"const": "tools/commercial-ux/native/test-realtime-candidate-authority.py"},
                "role": {"const": "ADVERSARIAL_TEST_SPEC_NON_RUNTIME"}
              }, "required": ["path", "role"]}
            ]}
          ],
          "items": false
        },
        "filesSha256": {"$ref": "#/$defs/sha256"},
        "runningFilesMatchGitBlobs": {"const": true},
        "gitCommandAuthority": {"const": {
          "path": "/Library/Developer/CommandLineTools/usr/bin/git",
          "rawSha256": "sha256:be4afb2b003904725826250de9fb76567bbacf82323457b5a1ec26706b66bcae",
          "byteLength": 7604272,
          "versionOutput": "git version 2.50.1 (Apple Git-155)",
          "commandBindingScope": "DIRECT_COMMAND_BINARY_BYTES_AND_VERSION_ONLY_TRANSITIVE_CLOSURE_UNBOUND",
          "allowedReadOnlySubcommands": [
            "--version", "cat-file", "ls-tree", "rev-parse"
          ],
          "globalArguments": [
            "--no-replace-objects",
            "--no-lazy-fetch",
            "--git-dir=<RESOLVED_GIT_DIRECTORY>",
            "--work-tree=<RESOLVED_REPOSITORY_ROOT>",
            "-c",
            "core.hooksPath=/dev/null"
          ],
          "environment": {
            "PATH": "/Library/Developer/CommandLineTools/usr/bin:/usr/bin:/bin",
            "LANG": "C",
            "LC_ALL": "C",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_CONFIG_SYSTEM": "/dev/null",
            "GIT_NO_LAZY_FETCH": "1",
            "GIT_NO_REPLACE_OBJECTS": "1",
            "GIT_OPTIONAL_LOCKS": "0",
            "GIT_TERMINAL_PROMPT": "0"
          },
          "environmentPolicy": "FRESH_ALLOWLIST_DROPS_AMBIENT_GIT_ENV",
          "repositoryLocationPolicy": "EXPLICIT_RESOLVED_GIT_DIR_AND_WORK_TREE",
          "gitDirectoryEntryPolicy": "NON_SYMLINK_DIRECTORY_OR_STRICT_GITDIR_FILE_TO_NON_SYMLINK_DIRECTORY",
          "replacementObjectPolicy": "DISABLED_BY_CLI_AND_ENV",
          "lazyFetchPolicy": "DISABLED_BY_CLI_AND_ENV",
          "linkedWorktreeHeadPolicy": "PER_WORKTREE_GIT_DIR",
          "objectFormat": "sha1",
          "objectIdHexLength": 40,
          "systemTrustLimitation": "GIT_EXECUTABLE_ONLY_TRANSITIVE_SYSTEM_DYLIB_CLOSURE_NOT_BOUND",
          "transitiveClosureBound": false
        }},
        "semanticVerifierEntryPoint": {"const": "verify_manifest_against_reconstructed_authority"},
        "semanticVerifierReexecutesHeadlessProbes": {"const": true},
        "structuralSchemaAuthority": {"const": "STRUCTURAL_ONLY_NOT_CANDIDATE_AUTHORITY"}
      }
    },
    "evaluatorProducerFileRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "role", "gitMode", "gitObjectId", "rawSha256", "byteLength"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "role": {"enum": [
          "EVALUATOR_PRODUCER_AND_SEMANTIC_VERIFIER",
          "STRUCTURAL_SCHEMA_NON_AUTHORITY",
          "EVALUATOR_POLICY",
          "ADVERSARIAL_TEST_SPEC_NON_RUNTIME"
        ]},
        "gitMode": {"enum": ["100644", "100755"]},
        "gitObjectId": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rawSha256": {"$ref": "#/$defs/sha256"},
        "byteLength": {"type": "integer", "minimum": 1}
      }
    },
    "gitFileRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "gitMode", "gitObjectId", "rawSha256", "byteLength"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "role": {"enum": [
          "BUILD_DECLARATION",
          "CORE_DEBUG_COMPILE_SOURCE",
          "DECLARED_NONRUNTIME_FULL_V3_AUTHORITY",
          "GAME_DEBUG_COMPILE_SOURCE",
          "GAME_DEBUG_EMBEDDED_RESOURCE",
          "NEGATIVE_DEFAULT_SCENE_AUTHORITY",
          "NEGATIVE_EXPORT_AUTHORITY",
          "R2_RUNTIME_SCENE_RESOURCE",
          "R2_SCRIPT_UID",
          "STORED_STORY_MANIFEST",
          "STORY_HARNESS_SOURCE"
        ]},
        "gitMode": {"enum": ["100644", "100755"]},
        "gitObjectId": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rawSha256": {"$ref": "#/$defs/sha256"},
        "byteLength": {"type": "integer", "minimum": 1}
      }
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "sourceInputsSha256"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 170,
          "maxItems": 170,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gitFileRow"},
          "allOf": [
            {"$ref": "#/$defs/countBuild"},
            {"$ref": "#/$defs/countCore"},
            {"$ref": "#/$defs/countDeclaredV3"},
            {"$ref": "#/$defs/countGame"},
            {"$ref": "#/$defs/countResources"},
            {"$ref": "#/$defs/countNegativeDefault"},
            {"$ref": "#/$defs/countNegativeExport"},
            {"$ref": "#/$defs/countRuntimeScene"},
            {"$ref": "#/$defs/countUid"},
            {"$ref": "#/$defs/countStoredStory"},
            {"$ref": "#/$defs/countStoryHarness"}
          ]
        },
        "sourceInputsSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "countBuild": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "BUILD_DECLARATION"}}, "required": ["role"]}, "minContains": 5, "maxContains": 5},
    "countCore": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "CORE_DEBUG_COMPILE_SOURCE"}}, "required": ["role"]}, "minContains": 67, "maxContains": 67},
    "countDeclaredV3": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "DECLARED_NONRUNTIME_FULL_V3_AUTHORITY"}}, "required": ["role"]}, "minContains": 2, "maxContains": 2},
    "countGame": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "GAME_DEBUG_COMPILE_SOURCE"}}, "required": ["role"]}, "minContains": 60, "maxContains": 60},
    "countResources": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "GAME_DEBUG_EMBEDDED_RESOURCE"}}, "required": ["role"]}, "minContains": 9, "maxContains": 9},
    "countNegativeDefault": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "NEGATIVE_DEFAULT_SCENE_AUTHORITY"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
    "countNegativeExport": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "NEGATIVE_EXPORT_AUTHORITY"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
    "countRuntimeScene": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "R2_RUNTIME_SCENE_RESOURCE"}}, "required": ["role"]}, "minContains": 11, "maxContains": 11},
    "countUid": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "R2_SCRIPT_UID"}}, "required": ["role"]}, "minContains": 11, "maxContains": 11},
    "countStoredStory": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "STORED_STORY_MANIFEST"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
    "countStoryHarness": {"type": "array", "contains": {"type": "object", "properties": {"role": {"const": "STORY_HARNESS_SOURCE"}}, "required": ["role"]}, "minContains": 2, "maxContains": 2},
    "managedBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration", "compileCounts", "resourceCount", "dotnetSdkVersion",
        "dotnetAuthority", "packageInputs", "packageInputsSha256", "generatedInputs",
        "generatedInputsSha256", "godotScriptPathAuthority", "outputs",
        "negativeExportAuthority"
      ],
      "properties": {
        "configuration": {"const": "Debug"},
        "compileCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["game", "core"],
          "properties": {"game": {"const": 60}, "core": {"const": 67}}
        },
        "resourceCount": {"const": 9},
        "dotnetSdkVersion": {"const": "8.0.129"},
        "dotnetAuthority": {"$ref": "#/$defs/dotnetAuthority"},
        "packageInputs": {"$ref": "#/$defs/packageRows"},
        "packageInputsSha256": {"$ref": "#/$defs/sha256"},
        "generatedInputs": {"$ref": "#/$defs/generatedRows"},
        "generatedInputsSha256": {"$ref": "#/$defs/sha256"},
        "godotScriptPathAuthority": {"$ref": "#/$defs/godotScriptPathAuthority"},
        "outputs": {"$ref": "#/$defs/managedRows"},
        "negativeExportAuthority": {"$ref": "#/$defs/negativeExportAuthority"}
      }
    },
    "godotScriptPathAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "godotProjectDir", "pathEncoding", "sceneAttachedScriptCount",
        "resourcePaths", "escapedResourcePathCount"
      ],
      "properties": {
        "godotProjectDir": {"const": "$CANDIDATE_SOURCE_ROOT/game"},
        "pathEncoding": {"const": "GODOT_SCRIPT_PATH_ATTRIBUTE_RES_URI"},
        "sceneAttachedScriptCount": {"const": 12},
        "resourcePaths": {"const": [
          "res://realtime/r2/RealtimePlaceholderMap.cs",
          "res://realtime/r2/RealtimeSliceCheckpointRunner.cs",
          "res://realtime/r2/RealtimeSliceMain.cs",
          "res://realtime/ui/RealtimeActionDock.cs",
          "res://realtime/ui/RealtimeBuildShelf.cs",
          "res://realtime/ui/RealtimeContextDock.cs",
          "res://realtime/ui/RealtimeEventRail.cs",
          "res://realtime/ui/RealtimeFocusScope.cs",
          "res://realtime/ui/RealtimeInputRouter.cs",
          "res://realtime/ui/RealtimeModalHost.cs",
          "res://realtime/ui/RealtimeTopHud.cs",
          "res://realtime/ui/RealtimeUiRoot.cs"
        ]},
        "escapedResourcePathCount": {"const": 0}
      }
    },
    "negativeExportAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration", "gameCompileCount", "coreCompileCount", "resourceCount",
        "realtimeR2GameCompileCount", "realtimeUiGameCompileCount",
        "realtimeV3CoreCompileCount", "candidateKind"
      ],
      "properties": {
        "configuration": {"const": "ExportRelease"},
        "gameCompileCount": {"const": 9},
        "coreCompileCount": {"const": 20},
        "resourceCount": {"const": 3},
        "realtimeR2GameCompileCount": {"const": 0},
        "realtimeUiGameCompileCount": {"const": 0},
        "realtimeV3CoreCompileCount": {"const": 0},
        "candidateKind": {"const": "NOT_R2_CANDIDATE"}
      }
    },
    "dotnetAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "filesSha256"],
      "properties": {
        "files": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "prefixItems": [
            {"$ref": "#/$defs/dotnetWrapperRow"},
            {"$ref": "#/$defs/dotnetHostRow"}
          ],
          "items": false
        },
        "filesSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dotnetWrapperRow": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "rawSha256", "byteLength"],
      "properties": {
        "path": {"const": "bin/dotnet"}, "role": {"const": "DOTNET_COMMAND_WRAPPER"},
        "rawSha256": {"$ref": "#/$defs/sha256"}, "byteLength": {"type": "integer", "minimum": 1}
      }
    },
    "dotnetHostRow": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "rawSha256", "byteLength"],
      "properties": {
        "path": {"const": "libexec/dotnet"}, "role": {"const": "DOTNET_HOST_EXECUTABLE"},
        "rawSha256": {"$ref": "#/$defs/sha256"}, "byteLength": {"type": "integer", "minimum": 1}
      }
    },
    "packageRows": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "prefixItems": [
        {"allOf": [
          {"$ref": "#/$defs/packageInputRow"},
          {"type": "object", "properties": {"path": {"const": "godot.net.sdk/4.7.1/godot.net.sdk.4.7.1.nupkg"}}, "required": ["path"]}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/packageInputRow"},
          {"type": "object", "properties": {"path": {"const": "godot.sourcegenerators/4.7.1/godot.sourcegenerators.4.7.1.nupkg"}}, "required": ["path"]}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/packageInputRow"},
          {"type": "object", "properties": {"path": {"const": "godotsharp/4.7.1/godotsharp.4.7.1.nupkg"}}, "required": ["path"]}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/packageInputRow"},
          {"type": "object", "properties": {"path": {"const": "godotsharpeditor/4.7.1/godotsharpeditor.4.7.1.nupkg"}}, "required": ["path"]}
        ]}
      ],
      "items": false
    },
    "packageInputRow": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "rawSha256", "byteLength"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "role": {"const": "GODOT_BUILD_PACKAGE"},
        "rawSha256": {"$ref": "#/$defs/sha256"},
        "byteLength": {"type": "integer", "minimum": 1}
      }
    },
    "generatedRows": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "prefixItems": [
        {"allOf": [
          {"$ref": "#/$defs/generatedInputRow"},
          {"type": "object", "properties": {"path": {"const": "generated/CandidateCore.csproj"}}, "required": ["path"]}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/generatedInputRow"},
          {"type": "object", "properties": {"path": {"const": "generated/CandidateGame.csproj"}}, "required": ["path"]}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/generatedInputRow"},
