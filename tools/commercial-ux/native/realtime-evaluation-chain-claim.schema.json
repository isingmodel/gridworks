{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/realtime-evaluation-chain-claim-v1.json",
  "title": "Gridworks realtime finalized evaluation-chain parent claim",
  "$comment": "STRUCTURAL VALIDATION ONLY; NON-AUTHORITATIVE. Schema success never establishes parent-session finality, Git provenance, snapshot identity, native UX, model execution, evidence, score, or artifact authority. Consumers MUST run verify_chain_claim_against_reconstructed_authority. evaluationChainClaimSha256 is SHA-256 of GRIDWORKS_CANONICAL_JSON_V1 bytes for this object with evaluationChainClaimSha256 omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalization",
    "status",
    "chainPolicyRawSha256",
    "chainClaimSchemaRawSha256",
    "chainAuthoritySourceCommit",
    "chainEvaluatorAuthority",
    "chainId",
    "chainNonce",
    "canonicalChainRoot",
    "canonicalClaimPath",
    "chainRootBindingSha256",
    "parentSessionAuthority",
    "routeBoundary",
    "attemptAudit",
    "selectedRouteTerminal",
    "inputSnapshot",
    "fixedFutureArtifactPaths",
    "futureArtifactPlan",
    "producerPlan",
    "modelExecutionAuthority",
    "finalizationAuthority",
    "officialCommercialUX",
    "scoreBearingCaptureAllowed",
    "commercialUXProxy",
    "claimProducerExecutionAttested",
    "freshnessAuthority",
    "limitations",
    "evaluationChainClaimSha256"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "gridworks.realtime-evaluation-chain-claim.v1"},
    "canonicalization": {"type": "string", "const": "GRIDWORKS_CANONICAL_JSON_V1"},
    "status": {"type": "string", "const": "FINALIZED_PARENT_PREFIX_NO_EVALUATION_OUTPUTS"},
    "chainPolicyRawSha256": {"$ref": "#/$defs/sha256"},
    "chainClaimSchemaRawSha256": {"$ref": "#/$defs/sha256"},
    "chainAuthoritySourceCommit": {"$ref": "#/$defs/gitCommit"},
    "chainEvaluatorAuthority": {"$ref": "#/$defs/chainEvaluatorAuthority"},
    "chainId": {"$ref": "#/$defs/sha256"},
    "chainNonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalChainRoot": {"$ref": "#/$defs/absolutePath"},
    "canonicalClaimPath": {
      "allOf": [
        {"$ref": "#/$defs/absolutePath"},
        {"type": "string", "pattern": "/evaluation-chain-claim\\.json$"}
      ]
    },
    "chainRootBindingSha256": {"$ref": "#/$defs/sha256"},
    "parentSessionAuthority": {"$ref": "#/$defs/parentSessionAuthority"},
    "routeBoundary": {
      "oneOf": [
        {"$ref": "#/$defs/targetedRouteBoundary"},
        {"$ref": "#/$defs/storyRouteBoundary"},
        {"$ref": "#/$defs/fullFlowRouteBoundary"}
      ]
    },
    "attemptAudit": {
      "oneOf": [
        {"$ref": "#/$defs/emptyAttemptAudit"},
        {"$ref": "#/$defs/oneAttemptAudit"},
        {"$ref": "#/$defs/twoAttemptAudit"},
        {"$ref": "#/$defs/threeAttemptAudit"}
      ]
    },
    "selectedRouteTerminal": {
      "oneOf": [
        {"$ref": "#/$defs/selectedAttemptTerminal"},
        {"$ref": "#/$defs/selectedUnavailableTerminal"}
      ]
    },
    "inputSnapshot": {"$ref": "#/$defs/inputSnapshot"},
    "fixedFutureArtifactPaths": {"$ref": "#/$defs/fixedFutureArtifactPaths"},
    "futureArtifactPlan": {"$ref": "#/$defs/futureArtifactPlan"},
    "producerPlan": {"$ref": "#/$defs/producerPlan"},
    "modelExecutionAuthority": {"$ref": "#/$defs/modelExecutionAuthority"},
    "finalizationAuthority": {"$ref": "#/$defs/finalizationAuthority"},
    "officialCommercialUX": {"type": "boolean", "const": false},
    "scoreBearingCaptureAllowed": {"type": "boolean", "const": false},
    "commercialUXProxy": {"type": "null"},
    "claimProducerExecutionAttested": {"type": "boolean", "const": false},
    "freshnessAuthority": {"type": "string", "const": "LOCAL_OS_RANDOM_NON_SCORE_ONLY"},
    "limitations": {
      "type": "array",
      "const": [
        "NO_INTERACTIVE_NATIVE_CAPTURE",
        "NO_ACTOR_EVIDENCE_JUDGE_VERIFIER_OR_AGGREGATE_OUTPUT",
        "MODEL_ULTRA_EXECUTION_RECEIPT_NOT_BOUND",
        "FULL_FLOW_UNAVAILABLE_NOT_IMPLEMENTED",
        "STORY_PART_UNIT_IS_NOT_NATIVE_REACHABILITY",
        "FUTURE_EVENT_STATUS_BAR_NATIVE_QUALITY_NOT_OBSERVED",
        "LOCAL_NONCE_IS_NOT_PLATFORM_FRESHNESS_RECEIPT",
        "CHAIN_PRODUCER_EXECUTION_NOT_EXTERNALLY_ATTESTED",
        "PYTHON_STDLIB_OS_TRUST_BASE_UNBOUND",
        "SCORE_BEARING_CAPTURE_FORBIDDEN"
      ]
    },
    "evaluationChainClaimSha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "routeBoundary": {
            "type": "object",
            "properties": {"routeKind": {"type": "string", "const": "FULL_FLOW_EXCEPTION"}},
            "required": ["routeKind"]
          }
        },
        "required": ["routeBoundary"]
      },
      "then": {
        "type": "object",
        "properties": {
          "attemptAudit": {"type": "array", "maxItems": 0},
          "selectedRouteTerminal": {"$ref": "#/$defs/selectedUnavailableTerminal"},
          "inputSnapshot": {
            "type": "object",
            "properties": {
              "fileCount": {"type": "integer", "const": 4},
              "files": {"$ref": "#/$defs/fullFlowSnapshotFiles"}
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "attemptAudit": {"type": "array", "minItems": 1, "maxItems": 3},
          "selectedRouteTerminal": {"$ref": "#/$defs/selectedAttemptTerminal"}
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "selectedRouteTerminal": {
            "type": "object",
            "properties": {"attemptOrdinal": {"type": "integer", "const": 1}},
            "required": ["attemptOrdinal"]
          }
        },
        "required": ["selectedRouteTerminal"]
      },
      "then": {
        "type": "object",
        "properties": {
          "attemptAudit": {"$ref": "#/$defs/oneAttemptAudit"},
          "selectedRouteTerminal": {
            "type": "object",
            "properties": {
              "terminalSnapshotRelativePath": {"type": "string", "const": "inputs/session/attempts/01/terminal-receipt.json"}
            }
          },
          "inputSnapshot": {
            "type": "object",
            "properties": {
              "fileCount": {"type": "integer", "const": 6},
              "files": {"type": "array", "minItems": 6, "maxItems": 6}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "selectedRouteTerminal": {
            "type": "object",
            "properties": {"attemptOrdinal": {"type": "integer", "const": 2}},
            "required": ["attemptOrdinal"]
          }
        },
        "required": ["selectedRouteTerminal"]
      },
      "then": {
        "type": "object",
        "properties": {
          "attemptAudit": {"$ref": "#/$defs/twoAttemptAudit"},
          "selectedRouteTerminal": {
            "type": "object",
            "properties": {
              "terminalSnapshotRelativePath": {"type": "string", "const": "inputs/session/attempts/02/terminal-receipt.json"}
            }
          },
          "inputSnapshot": {
            "type": "object",
            "properties": {
              "fileCount": {"type": "integer", "const": 9},
              "files": {"type": "array", "minItems": 9, "maxItems": 9}
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "selectedRouteTerminal": {
            "type": "object",
            "properties": {"attemptOrdinal": {"type": "integer", "const": 3}},
            "required": ["attemptOrdinal"]
          }
        },
        "required": ["selectedRouteTerminal"]
      },
      "then": {
        "type": "object",
        "properties": {
          "attemptAudit": {"$ref": "#/$defs/threeAttemptAudit"},
          "selectedRouteTerminal": {
            "type": "object",
            "properties": {
              "terminalSnapshotRelativePath": {"type": "string", "const": "inputs/session/attempts/03/terminal-receipt.json"}
            }
          },
          "inputSnapshot": {
            "type": "object",
            "properties": {
              "fileCount": {"type": "integer", "const": 12},
              "files": {"type": "array", "minItems": 12, "maxItems": 12}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:/\\.\\.?)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f])[^\\u0000]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])[^\\u0000]+$"
    },
    "chainEvaluatorAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourceCommit",
        "fileCount",
        "files",
        "filesSha256",
        "runningFilesMatchGitBlobs",
        "gitCommandAuthority",
        "parentSessionSemanticVerifierDependencyBound",
        "semanticVerifierEntryPoint",
        "structuralSchemaAuthority"
      ],
      "properties": {
        "schemaVersion": {"type": "string", "const": "gridworks.realtime-evaluation-chain-producer-authority.v1"},
        "sourceCommit": {"$ref": "#/$defs/gitCommit"},
        "fileCount": {"type": "integer", "const": 5},
        "files": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/evaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"type": "string", "const": "tools/commercial-ux/native/realtime-evaluation-chain-authority.py"},
                  "role": {"type": "string", "const": "CHAIN_CLAIM_PRODUCER_AND_SEMANTIC_VERIFIER"}
                }}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/evaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"type": "string", "const": "tools/commercial-ux/native/realtime-evaluation-chain-claim.schema.json"},
                  "role": {"type": "string", "const": "STRUCTURAL_CHAIN_CLAIM_SCHEMA_NON_AUTHORITY"}
                }}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/evaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"type": "string", "const": "tools/commercial-ux/native/realtime-evaluation-chain-policy.json"},
                  "role": {"type": "string", "const": "CHAIN_POLICY"}
                }}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/evaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"type": "string", "const": "tools/commercial-ux/native/realtime-session-authority.py"},
                  "role": {"type": "string", "const": "BOUND_PARENT_SESSION_SEMANTIC_VERIFIER_DEPENDENCY"}
                }}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/evaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"type": "string", "const": "tools/commercial-ux/native/test-realtime-evaluation-chain-authority.py"},
                  "role": {"type": "string", "const": "ADVERSARIAL_CHAIN_CLAIM_TEST_SPEC_NON_RUNTIME"}
                }}
              ]
            }
          ],
          "items": false
        },
        "filesSha256": {"$ref": "#/$defs/sha256"},
        "runningFilesMatchGitBlobs": {"type": "boolean", "const": true},
        "gitCommandAuthority": {"$ref": "#/$defs/gitCommandAuthority"},
        "parentSessionSemanticVerifierDependencyBound": {"type": "boolean", "const": true},
        "semanticVerifierEntryPoint": {"type": "string", "const": "verify_chain_claim_against_reconstructed_authority"},
        "structuralSchemaAuthority": {"type": "string", "const": "STRUCTURAL_ONLY_NOT_CHAIN_AUTHORITY"}
      }
    },
    "evaluatorFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "gitMode", "gitObjectId", "rawSha256", "byteLength"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "role": {
          "type": "string",
          "enum": [
            "CHAIN_CLAIM_PRODUCER_AND_SEMANTIC_VERIFIER",
            "STRUCTURAL_CHAIN_CLAIM_SCHEMA_NON_AUTHORITY",
            "CHAIN_POLICY",
            "BOUND_PARENT_SESSION_SEMANTIC_VERIFIER_DEPENDENCY",
            "ADVERSARIAL_CHAIN_CLAIM_TEST_SPEC_NON_RUNTIME"
          ]
        },
        "gitMode": {"type": "string", "enum": ["100644", "100755"]},
        "gitObjectId": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rawSha256": {"$ref": "#/$defs/sha256"},
        "byteLength": {"type": "integer", "minimum": 1}
      }
    },
    "gitCommandAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "rawSha256", "byteLength", "versionOutput", "commandBindingScope",
        "allowedReadOnlySubcommands", "globalArguments", "environment", "environmentPolicy",
        "repositoryLocationPolicy", "gitDirectoryEntryPolicy", "replacementObjectPolicy",
        "lazyFetchPolicy", "linkedWorktreeHeadPolicy", "objectFormat", "objectIdHexLength",
        "systemTrustLimitation", "transitiveClosureBound"
      ],
      "properties": {
        "path": {"type": "string", "const": "/Library/Developer/CommandLineTools/usr/bin/git"},
        "rawSha256": {"type": "string", "const": "sha256:be4afb2b003904725826250de9fb76567bbacf82323457b5a1ec26706b66bcae"},
        "byteLength": {"type": "integer", "const": 7604272},
        "versionOutput": {"type": "string", "const": "git version 2.50.1 (Apple Git-155)"},
        "commandBindingScope": {"type": "string", "const": "DIRECT_COMMAND_BINARY_BYTES_AND_VERSION_ONLY_TRANSITIVE_CLOSURE_UNBOUND"},
        "allowedReadOnlySubcommands": {"type": "array", "const": ["--version", "cat-file", "ls-tree", "rev-parse"]},
        "globalArguments": {"type": "array", "const": ["--no-replace-objects", "--no-lazy-fetch", "--git-dir=<RESOLVED_GIT_DIRECTORY>", "--work-tree=<RESOLVED_REPOSITORY_ROOT>", "-c", "core.hooksPath=/dev/null"]},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["PATH", "LANG", "LC_ALL", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM", "GIT_CONFIG_SYSTEM", "GIT_NO_LAZY_FETCH", "GIT_NO_REPLACE_OBJECTS", "GIT_OPTIONAL_LOCKS", "GIT_TERMINAL_PROMPT"],
          "properties": {
            "PATH": {"type": "string", "const": "/Library/Developer/CommandLineTools/usr/bin:/usr/bin:/bin"},
            "LANG": {"type": "string", "const": "C"},
            "LC_ALL": {"type": "string", "const": "C"},
            "GIT_CONFIG_GLOBAL": {"type": "string", "const": "/dev/null"},
            "GIT_CONFIG_NOSYSTEM": {"type": "string", "const": "1"},
            "GIT_CONFIG_SYSTEM": {"type": "string", "const": "/dev/null"},
            "GIT_NO_LAZY_FETCH": {"type": "string", "const": "1"},
            "GIT_NO_REPLACE_OBJECTS": {"type": "string", "const": "1"},
            "GIT_OPTIONAL_LOCKS": {"type": "string", "const": "0"},
            "GIT_TERMINAL_PROMPT": {"type": "string", "const": "0"}
          }
        },
        "environmentPolicy": {"type": "string", "const": "FRESH_ALLOWLIST_DROPS_AMBIENT_GIT_ENV"},
        "repositoryLocationPolicy": {"type": "string", "const": "EXPLICIT_RESOLVED_GIT_DIR_AND_WORK_TREE"},
        "gitDirectoryEntryPolicy": {"type": "string", "const": "NON_SYMLINK_DIRECTORY_OR_STRICT_GITDIR_FILE_TO_NON_SYMLINK_DIRECTORY"},
        "replacementObjectPolicy": {"type": "string", "const": "DISABLED_BY_CLI_AND_ENV"},
        "lazyFetchPolicy": {"type": "string", "const": "DISABLED_BY_CLI_AND_ENV"},
        "linkedWorktreeHeadPolicy": {"type": "string", "const": "PER_WORKTREE_GIT_DIR"},
        "objectFormat": {"type": "string", "const": "sha1"},
        "objectIdHexLength": {"type": "integer", "const": 40},
        "systemTrustLimitation": {"type": "string", "const": "GIT_EXECUTABLE_ONLY_TRANSITIVE_SYSTEM_DYLIB_CLOSURE_NOT_BOUND"},
        "transitiveClosureBound": {"type": "boolean", "const": false}
      }
    },
    "parentSessionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId", "canonicalSessionRoot", "canonicalSessionClaimPath",
        "sessionClaimSha256", "sessionClaimRawSha256", "sessionAuthoritySourceCommit",
        "sessionEvaluatorProducerFilesSha256", "sessionPolicyRawSha256", "candidateSha256",
        "candidateSourceCommit", "candidateManifestRawSha256", "candidateExecutionSha256",
        "candidatePackageTreeSha256", "candidateEvaluatorProducerFilesSha256",
        "storyManifestRawSha256", "routeBindingSha256",
        "parentSemanticVerificationUnderClaimLock"
      ],
      "properties": {
        "sessionId": {"$ref": "#/$defs/sha256"},
        "canonicalSessionRoot": {"$ref": "#/$defs/absolutePath"},
        "canonicalSessionClaimPath": {
          "allOf": [
            {"$ref": "#/$defs/absolutePath"},
            {"type": "string", "pattern": "/session-claim\\.json$"}
          ]
        },
        "sessionClaimSha256": {"$ref": "#/$defs/sha256"},
        "sessionClaimRawSha256": {"$ref": "#/$defs/sha256"},
        "sessionAuthoritySourceCommit": {"type": "string", "const": "5a31ff35a6e2d293c2f1800e4297945ecf3a5584"},
        "sessionEvaluatorProducerFilesSha256": {"type": "string", "const": "sha256:faea99acbc3a09334ccc8fbb9140a894f99fbfb0340ce224e9f12cba9b54b3e9"},
        "sessionPolicyRawSha256": {"type": "string", "const": "sha256:2a3e8fdb4167b395115b032025ba5cc99b3c21274c3a9c75961fb1405102bfb5"},
        "candidateSha256": {"type": "string", "const": "sha256:373785e45a4485dfeded43466a5bff0f66de4a0c106c972262686e7a432cbdd6"},
        "candidateSourceCommit": {"type": "string", "const": "379e9800c81ca315976ab4c28d511664df6ab7ed"},
        "candidateManifestRawSha256": {"type": "string", "const": "sha256:ca7826d38cae6e8a28e142e10e522e9c1425ba6abcec938182d9819ab0b2a816"},
        "candidateExecutionSha256": {"type": "string", "const": "sha256:b28ebbfcca183fa5de6b2fd483b00d563906c731ff8696dc2e0c4d17861da4e1"},
        "candidatePackageTreeSha256": {"$ref": "#/$defs/sha256"},
        "candidateEvaluatorProducerFilesSha256": {"type": "string", "const": "sha256:c501608b8d47a35c32860ad1defe33a369cbc0313ab0f860952def52ef4e881c"},
        "storyManifestRawSha256": {"type": "string", "const": "sha256:9072eef635220de62bf998088f88ea0ba86b2676f28085f16195f39712953180"},
        "routeBindingSha256": {"$ref": "#/$defs/sha256"},
        "parentSemanticVerificationUnderClaimLock": {"type": "boolean", "const": true}
      }
    },
    "routeBoundaryBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeKind", "candidateProfileId", "sessionProfileId", "selector", "availability",
        "executionAuthorized", "routeDisposition", "routeBindingSha256", "evidenceClass",
        "nativePresentationObserved", "scoreBearingEvidence", "futureEventStatusBar",
        "authoredReachabilityOnly", "nativeReachabilityClaim", "routeBoundarySha256"
      ],
      "properties": {
        "routeKind": {"type": "string", "enum": ["TARGETED_CHECKPOINT", "STORY_PART_UNIT", "FULL_FLOW_EXCEPTION"]},
        "candidateProfileId": {"type": ["string", "null"]},
        "sessionProfileId": {"type": "string", "enum": ["TARGETED_CHECKPOINT_DEBUG", "STORY_PART_UNIT", "FULL_FLOW_EXCEPTION"]},
        "selector": {"type": ["string", "null"]},
        "availability": {"type": "string", "enum": ["AVAILABLE_DIAGNOSTIC_ONLY", "AVAILABLE_CONTENT_UNIT_ONLY", "UNAVAILABLE_NOT_IMPLEMENTED"]},
        "executionAuthorized": {"type": "boolean"},
        "routeDisposition": {"type": "string", "enum": ["DIAGNOSTIC_ATTEMPT_AUTHORIZED", "CONTENT_UNIT_ATTEMPT_AUTHORIZED", "ROUTE_UNAVAILABLE_NO_EXECUTION"]},
        "routeBindingSha256": {"$ref": "#/$defs/sha256"},
        "evidenceClass": {"type": "string", "enum": ["HEADLESS_DIAGNOSTIC_ONLY", "AUTHORED_CONTENT_UNIT_ONLY", "UNAVAILABLE_ROUTE_TERMINAL_ONLY"]},
        "nativePresentationObserved": {"type": "boolean", "const": false},
        "scoreBearingEvidence": {"type": "boolean", "const": false},
        "futureEventStatusBar": {
          "oneOf": [
            {"$ref": "#/$defs/futureEventStatusBar"},
            {"type": "null"}
          ]
        },
        "authoredReachabilityOnly": {"type": "boolean"},
        "nativeReachabilityClaim": {"type": "boolean", "const": false},
        "routeBoundarySha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "targetedRouteBoundary": {
      "allOf": [
        {"$ref": "#/$defs/routeBoundaryBase"},
        {"type": "object", "properties": {
          "routeKind": {"type": "string", "const": "TARGETED_CHECKPOINT"},
          "candidateProfileId": {"type": "string", "const": "TARGETED_CHECKPOINT_DEBUG"},
          "sessionProfileId": {"type": "string", "const": "TARGETED_CHECKPOINT_DEBUG"},
          "selector": {"type": "string", "enum": ["A1_NORMAL_READY", "A1_CONSTRUCTION_DUE_1M"]},
          "availability": {"type": "string", "const": "AVAILABLE_DIAGNOSTIC_ONLY"},
          "executionAuthorized": {"type": "boolean", "const": true},
          "routeDisposition": {"type": "string", "const": "DIAGNOSTIC_ATTEMPT_AUTHORIZED"},
          "evidenceClass": {"type": "string", "const": "HEADLESS_DIAGNOSTIC_ONLY"},
          "futureEventStatusBar": {"$ref": "#/$defs/futureEventStatusBar"},
          "authoredReachabilityOnly": {"type": "boolean", "const": false}
        }}
      ]
    },
    "storyRouteBoundary": {
      "allOf": [
        {"$ref": "#/$defs/routeBoundaryBase"},
        {"type": "object", "properties": {
          "routeKind": {"type": "string", "const": "STORY_PART_UNIT"},
          "candidateProfileId": {"type": "null"},
          "sessionProfileId": {"type": "string", "const": "STORY_PART_UNIT"},
          "selector": {"type": "string", "minLength": 1},
          "availability": {"type": "string", "const": "AVAILABLE_CONTENT_UNIT_ONLY"},
          "executionAuthorized": {"type": "boolean", "const": true},
          "routeDisposition": {"type": "string", "const": "CONTENT_UNIT_ATTEMPT_AUTHORIZED"},
          "evidenceClass": {"type": "string", "const": "AUTHORED_CONTENT_UNIT_ONLY"},
          "futureEventStatusBar": {"type": "null"},
          "authoredReachabilityOnly": {"type": "boolean", "const": true}
        }}
      ]
    },
    "fullFlowRouteBoundary": {
      "allOf": [
        {"$ref": "#/$defs/routeBoundaryBase"},
        {"type": "object", "properties": {
          "routeKind": {"type": "string", "const": "FULL_FLOW_EXCEPTION"},
          "candidateProfileId": {"type": "string", "const": "FULL_FLOW_EXCEPTION"},
          "sessionProfileId": {"type": "string", "const": "FULL_FLOW_EXCEPTION"},
          "selector": {"type": "null"},
          "availability": {"type": "string", "const": "UNAVAILABLE_NOT_IMPLEMENTED"},
          "executionAuthorized": {"type": "boolean", "const": false},
          "routeDisposition": {"type": "string", "const": "ROUTE_UNAVAILABLE_NO_EXECUTION"},
          "evidenceClass": {"type": "string", "const": "UNAVAILABLE_ROUTE_TERMINAL_ONLY"},
          "futureEventStatusBar": {"type": "null"},
          "authoredReachabilityOnly": {"type": "boolean", "const": false}
        }}
      ]
    },
    "futureEventStatusBar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredSignals", "headlessWiringStatus", "nativeQualityStatus", "nativeQualityObserved"],
      "properties": {
        "requiredSignals": {"type": "array", "const": ["CURRENT_TIME", "NEXT_EVENT_COUNTDOWN", "EVENT_START_END", "CONSTRUCTION_COMPLETION", "PROMISE_DECISION_DEADLINE", "THERMAL_TRIP_RECOVERY"]},
        "headlessWiringStatus": {"type": "string", "const": "EXACT_PACKAGE_TWO_CHECKPOINT_SCENE_LOAD_PASS"},
        "nativeQualityStatus": {"type": "string", "const": "NOT_OBSERVED"},
        "nativeQualityObserved": {"type": "boolean", "const": false}
      }
    },
    "attemptAuditRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptOrdinal", "attemptId", "outcome", "outcomeRetryable", "nextAttemptAllowed", "startReceiptRawSha256", "outputRawSha256", "outputCanonicalSha256", "terminalReceiptRawSha256", "terminalReceiptSha256"],
      "properties": {
        "attemptOrdinal": {"type": "integer", "minimum": 1, "maximum": 3},
        "attemptId": {"$ref": "#/$defs/sha256"},
        "outcome": {"type": "string", "enum": ["PRODUCER_NO_OUTPUT", "TRANSPORT_FAILURE", "SUCCESS"]},
        "outcomeRetryable": {"type": "boolean"},
        "nextAttemptAllowed": {"type": "boolean"},
        "startReceiptRawSha256": {"$ref": "#/$defs/sha256"},
        "outputRawSha256": {"$ref": "#/$defs/sha256"},
        "outputCanonicalSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "terminalReceiptRawSha256": {"$ref": "#/$defs/sha256"},
        "terminalReceiptSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "retryAttemptAuditRow": {
      "allOf": [
        {"$ref": "#/$defs/attemptAuditRow"},
        {"type": "object", "properties": {
          "outcome": {"type": "string", "enum": ["PRODUCER_NO_OUTPUT", "TRANSPORT_FAILURE"]},
          "outcomeRetryable": {"type": "boolean", "const": true},
          "nextAttemptAllowed": {"type": "boolean", "const": true},
          "outputCanonicalSha256": {"type": "null"}
        }}
      ]
    },
    "successAttemptAuditRow": {
      "allOf": [
        {"$ref": "#/$defs/attemptAuditRow"},
        {"type": "object", "properties": {
          "outcome": {"type": "string", "const": "SUCCESS"},
          "outcomeRetryable": {"type": "boolean", "const": false},
          "nextAttemptAllowed": {"type": "boolean", "const": false},
          "outputCanonicalSha256": {"$ref": "#/$defs/sha256"}
        }}
      ]
    },
    "emptyAttemptAudit": {"type": "array", "maxItems": 0},
    "oneAttemptAudit": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {"allOf": [
          {"$ref": "#/$defs/successAttemptAuditRow"},
          {"type": "object", "properties": {"attemptOrdinal": {"type": "integer", "const": 1}}}
        ]}
      ],
      "items": false
    },
    "twoAttemptAudit": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"allOf": [
          {"$ref": "#/$defs/retryAttemptAuditRow"},
          {"type": "object", "properties": {"attemptOrdinal": {"type": "integer", "const": 1}}}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/successAttemptAuditRow"},
          {"type": "object", "properties": {"attemptOrdinal": {"type": "integer", "const": 2}}}
        ]}
      ],
      "items": false
    },
    "threeAttemptAudit": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"allOf": [
          {"$ref": "#/$defs/retryAttemptAuditRow"},
          {"type": "object", "properties": {"attemptOrdinal": {"type": "integer", "const": 1}}}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/retryAttemptAuditRow"},
          {"type": "object", "properties": {"attemptOrdinal": {"type": "integer", "const": 2}}}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/successAttemptAuditRow"},
          {"type": "object", "properties": {"attemptOrdinal": {"type": "integer", "const": 3}}}
        ]}
      ],
      "items": false
    },
    "selectedTerminalBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminalKind", "attemptOrdinal", "attemptId", "outcome", "terminalSnapshotRelativePath", "terminalRawSha256", "terminalSelfSha256"],
      "properties": {
        "terminalKind": {"type": "string", "enum": ["ATTEMPT_SUCCESS", "UNAVAILABLE_ROUTE_TERMINAL"]},
        "attemptOrdinal": {"type": ["integer", "null"], "minimum": 1, "maximum": 3},
        "attemptId": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "outcome": {"type": "string", "enum": ["SUCCESS", "ROUTE_UNAVAILABLE_NO_EXECUTION"]},
        "terminalSnapshotRelativePath": {"$ref": "#/$defs/relativePath"},
        "terminalRawSha256": {"$ref": "#/$defs/sha256"},
        "terminalSelfSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selectedAttemptTerminal": {
      "allOf": [
        {"$ref": "#/$defs/selectedTerminalBase"},
        {"type": "object", "properties": {
          "terminalKind": {"type": "string", "const": "ATTEMPT_SUCCESS"},
          "attemptOrdinal": {"type": "integer", "minimum": 1, "maximum": 3},
          "attemptId": {"$ref": "#/$defs/sha256"},
          "outcome": {"type": "string", "const": "SUCCESS"},
          "terminalSnapshotRelativePath": {"type": "string", "pattern": "^inputs/session/attempts/(01|02|03)/terminal-receipt\\.json$"}
        }}
      ]
    },
    "selectedUnavailableTerminal": {
      "allOf": [
        {"$ref": "#/$defs/selectedTerminalBase"},
        {"type": "object", "properties": {
          "terminalKind": {"type": "string", "const": "UNAVAILABLE_ROUTE_TERMINAL"},
          "attemptOrdinal": {"type": "null"},
          "attemptId": {"type": "null"},
          "outcome": {"type": "string", "const": "ROUTE_UNAVAILABLE_NO_EXECUTION"},
          "terminalSnapshotRelativePath": {"type": "string", "const": "inputs/session/unavailable-route-terminal.json"}
        }}
      ]
    },
    "inputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalInputRoot", "fileCount", "files", "treeSha256", "fullFinalizedPrefixCapturedUnderSessionClaimLock"],
      "properties": {
        "canonicalInputRoot": {
          "allOf": [
            {"$ref": "#/$defs/absolutePath"},
            {"type": "string", "pattern": "/inputs/session$"}
          ]
        },
        "fileCount": {"type": "integer", "minimum": 4, "maximum": 12},
        "files": {"type": "array", "minItems": 4, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/snapshotFile"}},
        "treeSha256": {"$ref": "#/$defs/sha256"},
        "fullFinalizedPrefixCapturedUnderSessionClaimLock": {"type": "boolean", "const": true}
      }
    },
    "snapshotFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "sourceLogicalPath", "snapshotRelativePath", "role", "materialization", "rawSha256", "canonicalSha256", "byteLength"],
      "properties": {
        "sourcePath": {"oneOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "null"}]},
        "sourceLogicalPath": {"$ref": "#/$defs/relativePath"},
        "snapshotRelativePath": {"type": "string", "pattern": "^inputs/session/(session-claim\\.json|inputs/(candidate-manifest|story-manifest)\\.json|attempts/(01|02|03)/(start-receipt|diagnostic-output|terminal-receipt)\\.json|unavailable-route-terminal\\.json)$"},
        "role": {"type": "string", "enum": ["FINALIZED_PARENT_SESSION_CLAIM", "BOUND_CANDIDATE_MANIFEST", "BOUND_STORY_MANIFEST", "ATTEMPT_START_RECEIPT", "ATTEMPT_DIAGNOSTIC_OUTPUT", "ATTEMPT_TERMINAL_RECEIPT", "CANONICAL_NESTED_UNAVAILABLE_ROUTE_TERMINAL"]},
        "materialization": {"type": "string", "enum": ["EXACT_PARENT_FILE_BYTES_UNDER_SESSION_CLAIM_FLOCK", "CANONICAL_EXTRACTION_FROM_FINALIZED_SESSION_CLAIM"]},
        "rawSha256": {"$ref": "#/$defs/sha256"},
        "canonicalSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "byteLength": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {"role": {"type": "string", "const": "CANONICAL_NESTED_UNAVAILABLE_ROUTE_TERMINAL"}},
            "required": ["role"]
          },
          "then": {
            "type": "object",
            "properties": {
              "sourcePath": {"type": "null"},
              "materialization": {"type": "string", "const": "CANONICAL_EXTRACTION_FROM_FINALIZED_SESSION_CLAIM"},
              "canonicalSha256": {"$ref": "#/$defs/sha256"},
              "byteLength": {"type": "integer", "minimum": 1}
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "sourcePath": {"$ref": "#/$defs/absolutePath"},
              "materialization": {"type": "string", "const": "EXACT_PARENT_FILE_BYTES_UNDER_SESSION_CLAIM_FLOCK"}
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {"role": {"type": "string", "const": "ATTEMPT_DIAGNOSTIC_OUTPUT"}},
            "required": ["role"]
          },
          "else": {
            "type": "object",
            "properties": {
              "canonicalSha256": {"$ref": "#/$defs/sha256"},
              "byteLength": {"type": "integer", "minimum": 1}
            }
          }
        }
      ]
    },
    "fullFlowSnapshotFiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/snapshotFile"},
            {"type": "object", "properties": {
              "sourcePath": {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/session-claim\\.json$"}]},
              "sourceLogicalPath": {"type": "string", "const": "session-claim.json"},
              "snapshotRelativePath": {"type": "string", "const": "inputs/session/session-claim.json"},
              "role": {"type": "string", "const": "FINALIZED_PARENT_SESSION_CLAIM"},
              "materialization": {"type": "string", "const": "EXACT_PARENT_FILE_BYTES_UNDER_SESSION_CLAIM_FLOCK"}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/snapshotFile"},
            {"type": "object", "properties": {
              "sourcePath": {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/inputs/candidate-manifest\\.json$"}]},
              "sourceLogicalPath": {"type": "string", "const": "inputs/candidate-manifest.json"},
              "snapshotRelativePath": {"type": "string", "const": "inputs/session/inputs/candidate-manifest.json"},
              "role": {"type": "string", "const": "BOUND_CANDIDATE_MANIFEST"},
              "materialization": {"type": "string", "const": "EXACT_PARENT_FILE_BYTES_UNDER_SESSION_CLAIM_FLOCK"}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/snapshotFile"},
            {"type": "object", "properties": {
              "sourcePath": {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/inputs/story-manifest\\.json$"}]},
              "sourceLogicalPath": {"type": "string", "const": "inputs/story-manifest.json"},
              "snapshotRelativePath": {"type": "string", "const": "inputs/session/inputs/story-manifest.json"},
              "role": {"type": "string", "const": "BOUND_STORY_MANIFEST"},
              "materialization": {"type": "string", "const": "EXACT_PARENT_FILE_BYTES_UNDER_SESSION_CLAIM_FLOCK"}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/snapshotFile"},
            {"type": "object", "properties": {
              "sourcePath": {"type": "null"},
              "sourceLogicalPath": {"type": "string", "const": "unavailable-route-terminal.json"},
              "snapshotRelativePath": {"type": "string", "const": "inputs/session/unavailable-route-terminal.json"},
              "role": {"type": "string", "const": "CANONICAL_NESTED_UNAVAILABLE_ROUTE_TERMINAL"},
              "materialization": {"type": "string", "const": "CANONICAL_EXTRACTION_FROM_FINALIZED_SESSION_CLAIM"}
            }}
          ]
        }
      ],
      "items": false
    },
    "fixedFutureArtifactPaths": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/artifacts/evidence-index\\.json$"}]},
        {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/artifacts/actor-terminal\\.json$"}]},
        {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/artifacts/judge-input\\.json$"}]},
        {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/artifacts/judge-terminal\\.json$"}]},
        {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/artifacts/verifier-result\\.json$"}]},
        {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/artifacts/oracle-ledger\\.json$"}]},
        {"allOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "string", "pattern": "/artifacts/aggregate\\.json$"}]}
      ],
      "items": false
    },
    "futureArtifactPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalArtifactRoot", "artifactRootRelativePath", "artifactRootCreatedAtClaimCreation", "creationAuthorizedByThisUnit", "orderedRelativePaths"],
      "properties": {
        "canonicalArtifactRoot": {
          "allOf": [
            {"$ref": "#/$defs/absolutePath"},
            {"type": "string", "pattern": "/artifacts$"}
          ]
        },
        "artifactRootRelativePath": {"type": "string", "const": "artifacts"},
        "artifactRootCreatedAtClaimCreation": {"type": "boolean", "const": false},
        "creationAuthorizedByThisUnit": {"type": "boolean", "const": false},
        "orderedRelativePaths": {"type": "array", "const": ["artifacts/evidence-index.json", "artifacts/actor-terminal.json", "artifacts/judge-input.json", "artifacts/judge-terminal.json", "artifacts/verifier-result.json", "artifacts/oracle-ledger.json", "artifacts/aggregate.json"]}
      }
    },
    "producerPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "evidence", "judge", "verifier", "oracle", "aggregate", "modelExecutionAuthority"],
      "properties": {
        "actor": {"type": "string", "const": "BLOCKED_NO_NATIVE_CAPTURE"},
        "evidence": {"type": "string", "const": "NOT_CREATED_DIAGNOSTIC_PREFIX_ONLY"},
        "judge": {"type": "string", "const": "UNAUTHORIZED_MODEL_RECEIPT_NOT_BOUND"},
        "verifier": {"type": "string", "const": "UNAUTHORIZED_NO_JUDGE_ARTIFACT"},
        "oracle": {"type": "string", "const": "PLANNED_DETERMINISTIC_NOT_CREATED"},
        "aggregate": {"type": "string", "const": "PLANNED_BLOCKED_NULL_NOT_CREATED"},
        "modelExecutionAuthority": {"type": "string", "const": "UNAVAILABLE_NO_PLATFORM_OR_EQUIVALENT_TRANSCRIPT_AUTHORITY_BOUND"}
      }
    },
    "modelExecutionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requiredModel", "requiredReasoningEffort", "platformOrEquivalentTranscriptAuthorityBound", "judgeExecutionAuthorized"],
      "properties": {
        "status": {"type": "string", "const": "UNAVAILABLE"},
        "requiredModel": {"type": "string", "const": "gpt-5.6-sol"},
        "requiredReasoningEffort": {"type": "string", "const": "ultra"},
        "platformOrEquivalentTranscriptAuthorityBound": {"type": "boolean", "const": false},
        "judgeExecutionAuthorized": {"type": "boolean", "const": false}
      }
    },
    "finalizationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionClaimFlockHeldAcrossVerificationSelectionSnapshotsAndClaim", "inputFilesExclusiveWriteFsyncCompleted", "inputDirectoriesFsyncCompleted", "artifactRootAbsentAtClaimCreation", "claimPathAbsentUntilAllInputsFinalized", "claimFileIsLastCommitMarker", "claimWriteMode"],
      "properties": {
        "sessionClaimFlockHeldAcrossVerificationSelectionSnapshotsAndClaim": {"type": "boolean", "const": true},
        "inputFilesExclusiveWriteFsyncCompleted": {"type": "boolean", "const": true},
        "inputDirectoriesFsyncCompleted": {"type": "boolean", "const": true},
        "artifactRootAbsentAtClaimCreation": {"type": "boolean", "const": true},
        "claimPathAbsentUntilAllInputsFinalized": {"type": "boolean", "const": true},
        "claimFileIsLastCommitMarker": {"type": "boolean", "const": true},
        "claimWriteMode": {"type": "string", "const": "O_EXCL_FSYNC_FILE_AND_PARENT"}
      }
    }
  }
}
