#!/bin/zsh

set -euo pipefail

repository_dir=${0:A:h}
godot_bin=${GRIDWORKS_GODOT_BIN:-"$repository_dir/.tools/godot-4.7.1/Godot_mono.app/Contents/MacOS/Godot"}

usage() {
    print -u2 -- "usage: ./dev build"
    print -u2 -- "       ./dev check"
    print -u2 -- "       ./dev play fixture"
    print -u2 -- "       ./dev play chapter CHAPTER_ID"
    print -u2 -- "       ./dev play through CHAPTER_ID"
    print -u2 -- "       ./dev checkpoint CHECKPOINT_ID"
    print -u2 -- "       ./dev story SELECTOR|manifest"
}

fail() {
    print -u2 -- "$1"
    exit 2
}

require_godot() {
    [[ -x $godot_bin ]] || fail "Godot executable not found: $godot_bin"
}

run_checkpoint() {
    local checkpoint_id=$1
    "$godot_bin" \
        --headless \
        --path "$repository_dir/game" \
        --scene res://realtime/r2/RealtimeSliceCheckpointRunner.tscn \
        -- \
        --checkpoint="$checkpoint_id"
}

run_product_entry_smoke() {
    "$godot_bin" \
        --headless \
        --path "$repository_dir/game" \
        --scene res://realtime/r2/RealtimeProductEntrySmokeRunner.tscn \
        "$@"
}

command_name=${1:-help}
if (( $# > 0 )); then
    shift
fi

cd "$repository_dir"

case $command_name in
    build)
        [[ $# -eq 0 ]] || fail "build takes no arguments."
        dotnet build "$repository_dir/Gridworks.sln" -c Debug
        ;;
    check)
        [[ $# -eq 0 ]] || fail "check takes no arguments."
        require_godot
        dotnet build "$repository_dir/Gridworks.sln" -c Debug
        dotnet run --project "$repository_dir/tools/Gridworks.RealtimeChecks" -c Release
        dotnet run --project "$repository_dir/tools/Gridworks.CommercialChecks" -c Release
        python3 "$repository_dir/tools/commercial-ux/test-realtime-text-plan-tools.py"
        python3 "$repository_dir/tools/commercial-ux/test-g3-a1-asset-allowlist.py"
        python3 "$repository_dir/tools/commercial-ux/test-realtime-default-entry.py"
        run_product_entry_smoke
        run_product_entry_smoke -- --technical-fixture
        run_checkpoint A1_NORMAL_READY
        run_checkpoint A1_CONSTRUCTION_DUE_1M
        ;;
    play)
        require_godot
        [[ $# -ge 1 ]] || fail "play requires fixture, chapter, or through."
        play_mode=$1
        shift
        dotnet build "$repository_dir/game/Gridworks.Game.csproj" -c Debug
        case $play_mode in
            fixture)
                [[ $# -eq 0 ]] || fail "play fixture takes no additional arguments."
                "$godot_bin" \
                    --path "$repository_dir/game" \
                    -- \
                    --technical-fixture
                ;;
            chapter)
                [[ $# -eq 1 ]] || fail "play chapter requires exactly one chapter ID."
                "$godot_bin" \
                    --path "$repository_dir/game" \
                    -- \
                    --release-chapter="$1"
                ;;
            through)
                [[ $# -eq 1 ]] || fail "play through requires exactly one chapter ID."
                "$godot_bin" \
                    --path "$repository_dir/game" \
                    -- \
                    --release-through="$1"
                ;;
            *)
                fail "Unknown play mode: $play_mode"
                ;;
        esac
        ;;
    checkpoint)
        require_godot
        [[ $# -eq 1 ]] || fail "checkpoint requires exactly one checkpoint ID."
        dotnet build "$repository_dir/game/Gridworks.Game.csproj" -c Debug
        run_checkpoint "$1"
        ;;
    story)
        [[ $# -eq 1 ]] || fail "story requires exactly one selector or manifest."
        if [[ $1 == manifest ]]; then
            dotnet run \
                --project "$repository_dir/tools/Gridworks.CommercialChecks" \
                -c Release \
                -- \
                --story-manifest
        else
            dotnet run \
                --project "$repository_dir/tools/Gridworks.CommercialChecks" \
                -c Release \
                -- \
                --story-part "$1"
        fi
        ;;
    help|-h|--help)
        [[ $# -eq 0 ]] || fail "help takes no arguments."
        usage
        ;;
    *)
        usage
        fail "Unknown development command: $command_name"
        ;;
esac
