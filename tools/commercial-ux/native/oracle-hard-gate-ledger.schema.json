{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/commercial-ux-native-oracle-hard-gate-ledger-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "ledgerId",
    "candidateManifestSha256",
    "holdoutConsumptionReceiptSha256",
    "goldBindingManifestSha256",
    "coldActorResponseSha256",
    "coldActorResponseRawSha256",
    "actorTraceSha256",
    "coverageActionLedgerSha256",
    "coverageArtifactId",
    "recordingManifestSha256",
    "anonymizationManifestSha256",
    "evidenceSetSha256",
    "sanitizedEvidenceBundleManifestSha256",
    "sanitizedEvidenceContentRootSha256",
    "candidateJudgeInputSha256",
    "verificationInputSha256",
    "verificationOutputSha256",
    "rubricSha256",
    "contractBindingsSha256",
    "canonicalHashPolicySha256",
    "goldStateContractSha256",
    "coverageRecipeSha256",
    "conceptManifestSha256",
    "nativeAggregatorSha256",
    "contractValidatorSha256",
    "goldValidatorSha256",
    "oracleChecks",
    "hardGates",
    "incidents",
    "scoreBearingReady"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gridworks.commercial-ux.native-oracle-hard-gate-ledger.v1"
    },
    "protocol": {"const": "GRIDWORKS-COMMERCIAL-UX-v1.1"},
    "ledgerId": {"type": "string", "minLength": 1, "maxLength": 200},
    "candidateManifestSha256": {"$ref": "#/$defs/sha256"},
    "holdoutConsumptionReceiptSha256": {"$ref": "#/$defs/sha256"},
    "goldBindingManifestSha256": {"$ref": "#/$defs/sha256"},
    "coldActorResponseSha256": {"$ref": "#/$defs/threeHashes"},
    "coldActorResponseRawSha256": {"$ref": "#/$defs/threeHashes"},
    "actorTraceSha256": {"$ref": "#/$defs/threeHashes"},
    "coverageActionLedgerSha256": {"$ref": "#/$defs/sha256"},
    "coverageArtifactId": {"$ref": "#/$defs/sha256"},
    "recordingManifestSha256": {"$ref": "#/$defs/fourHashes"},
    "anonymizationManifestSha256": {"$ref": "#/$defs/sha256"},
    "evidenceSetSha256": {"$ref": "#/$defs/sha256"},
    "sanitizedEvidenceBundleManifestSha256": {"$ref": "#/$defs/sha256"},
    "sanitizedEvidenceContentRootSha256": {"$ref": "#/$defs/sha256"},
    "candidateJudgeInputSha256": {"$ref": "#/$defs/sha256"},
    "verificationInputSha256": {"$ref": "#/$defs/sha256"},
    "verificationOutputSha256": {"$ref": "#/$defs/sha256"},
    "rubricSha256": {"$ref": "#/$defs/sha256"},
    "contractBindingsSha256": {"$ref": "#/$defs/sha256"},
    "canonicalHashPolicySha256": {"$ref": "#/$defs/sha256"},
    "goldStateContractSha256": {"$ref": "#/$defs/sha256"},
    "coverageRecipeSha256": {"$ref": "#/$defs/sha256"},
    "conceptManifestSha256": {"$ref": "#/$defs/sha256"},
    "nativeAggregatorSha256": {"$ref": "#/$defs/sha256"},
    "contractValidatorSha256": {"$ref": "#/$defs/sha256"},
    "goldValidatorSha256": {"$ref": "#/$defs/sha256"},
    "oracleChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/oracleCheck"}
    },
    "hardGates": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "prefixItems": [
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG01-AUTHORITY"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG02-STORY"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG03-REACHABILITY"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG04-BUILD"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG05-TYPED-DISPLAY"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG06-VIEWPORT"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG07-KEYBOARD"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG08-NONCOLOR"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG09-AUDIO"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG10-REPLAY"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG11-LIVENESS"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG12-RAW-ID"}}},
        {"$ref": "#/$defs/hardGate", "properties": {"gateId": {"const": "HG13-PROVENANCE"}}}
      ],
      "items": false
    },
    "incidents": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/incident"}
    },
    "scoreBearingReady": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "threeHashes": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "fourHashes": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "locator", "sha256"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 200},
        "locator": {"type": "string", "minLength": 1, "maxLength": 300},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "oracleCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracleCheckId",
        "domain",
        "inputHashes",
        "expectedCanonicalSha256",
        "observedCanonicalSha256",
        "status",
        "details",
        "evidenceRefs"
      ],
      "properties": {
        "oracleCheckId": {"type": "string", "pattern": "^ORACLE-[0-9]{4}$"},
        "domain": {
          "enum": [
            "SOURCE",
            "PATH",
            "BOTTLENECK",
            "THERMAL",
            "CASH",
            "RESULT",
            "SAVE",
            "STATE_HASH",
            "ACTION_COUNT",
            "AUDIO_TRANSITION"
          ]
        },
        "inputHashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "expectedCanonicalSha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "observedCanonicalSha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "status": {"enum": ["EXACT", "MISMATCH", "MISSING"]},
        "details": {"type": "string", "minLength": 1, "maxLength": 1600},
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactRef"}
        }
      }
    },
    "hardGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "producer",
        "predicate",
        "inputHashes",
        "status",
        "observed",
        "failureCode",
        "evidenceRefs"
      ],
      "properties": {
        "gateId": {
          "enum": [
            "HG01-AUTHORITY",
            "HG02-STORY",
            "HG03-REACHABILITY",
            "HG04-BUILD",
            "HG05-TYPED-DISPLAY",
            "HG06-VIEWPORT",
            "HG07-KEYBOARD",
            "HG08-NONCOLOR",
            "HG09-AUDIO",
            "HG10-REPLAY",
            "HG11-LIVENESS",
            "HG12-RAW-ID",
            "HG13-PROVENANCE"
          ]
        },
        "producer": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,99}$"},
        "predicate": {"type": "string", "minLength": 1, "maxLength": 1600},
        "inputHashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
        "observed": {"type": "string", "minLength": 1, "maxLength": 1600},
        "failureCode": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactRef"}
        }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incidentKey",
        "incidentType",
        "actorArtifactIds",
        "checkpointRefs",
        "verifierObservationId",
        "verifierStatus",
        "oracleStatus",
        "capCandidate",
        "critical",
        "description"
      ],
      "properties": {
        "incidentKey": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+/[A-Z0-9_-]+/[A-Z0-9_-]+/[A-Z0-9_-]+$"
        },
        "incidentType": {
          "enum": [
            "CONFUSION",
            "RECOVERY_FRICTION",
            "UX_STALL",
            "EXTERNAL_HINT_ATTEMPT",
            "HARD_GATE_FAILURE"
          ]
        },
        "actorArtifactIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ARTIFACT-[A-D]$"}
        },
        "checkpointRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "verifierObservationId": {
          "oneOf": [
            {"type": "string", "pattern": "^OBS-[0-9]{4}$"},
            {"type": "null"}
          ]
        },
        "verifierStatus": {"enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED", "NOT_APPLICABLE"]},
        "oracleStatus": {"enum": ["EXACT", "MISMATCH", "MISSING", "NOT_APPLICABLE"]},
        "capCandidate": {"enum": [100, 79, 69, 49]},
        "critical": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1600}
      },
      "allOf": [
        {
          "if": {
            "properties": {"incidentType": {"const": "HARD_GATE_FAILURE"}},
            "required": ["incidentType"]
          },
          "then": {
            "properties": {
              "verifierObservationId": {"type": "null"},
              "verifierStatus": {"const": "NOT_APPLICABLE"}
            }
          },
          "else": {
            "properties": {
              "verifierObservationId": {
                "type": "string",
                "pattern": "^OBS-[0-9]{4}$"
              },
              "verifierStatus": {
                "enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED"]
              }
            }
          }
        }
      ]
    }
  }
}
