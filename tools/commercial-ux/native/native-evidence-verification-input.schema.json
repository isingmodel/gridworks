{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/commercial-ux-native-evidence-verification-input-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "verificationScope",
    "verificationInputSha256",
    "candidateManifestSha256",
    "holdoutConsumptionReceiptSha256",
    "goldBindingManifestSha256",
    "evidenceSetSha256",
    "sanitizedEvidenceBundleManifestSha256",
    "sanitizedEvidenceBundleManifestRawSha256",
    "sanitizedEvidenceContentRootSha256",
    "opaqueJudgePanelSha256",
    "artifactBundles",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gridworks.commercial-ux.native-evidence-verification-input.v1"
    },
    "protocol": {
      "const": "GRIDWORKS-COMMERCIAL-UX-v1.1"
    },
    "verificationScope": {"const": "VISIBLE_OR_AUDIBLE_OBSERVATION_ONLY"},
    "verificationInputSha256": {"$ref": "#/$defs/sha256"},
    "candidateManifestSha256": {"$ref": "#/$defs/sha256"},
    "holdoutConsumptionReceiptSha256": {"$ref": "#/$defs/sha256"},
    "goldBindingManifestSha256": {"$ref": "#/$defs/sha256"},
    "evidenceSetSha256": {"$ref": "#/$defs/sha256"},
    "sanitizedEvidenceBundleManifestSha256": {"$ref": "#/$defs/sha256"},
    "sanitizedEvidenceBundleManifestRawSha256": {"$ref": "#/$defs/sha256"},
    "sanitizedEvidenceContentRootSha256": {"$ref": "#/$defs/sha256"},
    "opaqueJudgePanelSha256": {"$ref": "#/$defs/sha256"},
    "artifactBundles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/artifactBundle", "properties": {"anonymousArtifactId": {"const": "ARTIFACT-A"}}},
        {"$ref": "#/$defs/artifactBundle", "properties": {"anonymousArtifactId": {"const": "ARTIFACT-B"}}},
        {"$ref": "#/$defs/artifactBundle", "properties": {"anonymousArtifactId": {"const": "ARTIFACT-C"}}},
        {"$ref": "#/$defs/artifactBundle", "properties": {"anonymousArtifactId": {"const": "ARTIFACT-D"}}}
      ],
      "items": false
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 768,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifactBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anonymousArtifactId", "bundleId", "artifactBundleSha256",
        "bundleRootSha256", "canonicalBundleRoot", "bundleRootPathTail"
      ],
      "properties": {
        "anonymousArtifactId": {"type": "string", "pattern": "^ARTIFACT-[A-D]$"},
        "bundleId": {"type": "string", "minLength": 1, "maxLength": 200},
        "artifactBundleSha256": {"$ref": "#/$defs/sha256"},
        "bundleRootSha256": {"$ref": "#/$defs/sha256"},
        "canonicalBundleRoot": {
          "type": "string",
          "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000/]+(?:/[^\\u0000/]+)*$",
          "maxLength": 1000
        },
        "bundleRootPathTail": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"}
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anonymousArtifactId", "artifactId", "locator"],
      "properties": {
        "anonymousArtifactId": {"type": "string", "pattern": "^ARTIFACT-[A-D]$"},
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 200},
        "locator": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "claimType", "incidentKey", "claim", "citedSources"],
      "properties": {
        "observationId": {"type": "string", "pattern": "^OBS-[0-9]{4}$"},
        "claimType": {"enum": ["JUDGE_EVIDENCE", "ACTOR_INCIDENT"]},
        "incidentKey": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z0-9_-]+/[A-Z0-9_-]+/[A-Z0-9_-]+/[A-Z0-9_-]+$"
            },
            {"type": "null"}
          ]
        },
        "claim": {"type": "string", "minLength": 1, "maxLength": 1200},
        "citedSources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"claimType": {"const": "ACTOR_INCIDENT"}},
            "required": ["claimType"]
          },
          "then": {
            "properties": {
              "incidentKey": {
                "type": "string",
                "pattern": "^[A-Z0-9_-]+/[A-Z0-9_-]+/[A-Z0-9_-]+/[A-Z0-9_-]+$"
              }
            }
          },
          "else": {"properties": {"incidentKey": {"type": "null"}}}
        }
      ]
    }
  }
}
