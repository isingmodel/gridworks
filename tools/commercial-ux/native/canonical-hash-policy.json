{
  "schemaVersion": "gridworks.commercial-ux.canonical-hash-policy.v1",
  "protocol": "GRIDWORKS-COMMERCIAL-UX-v1.1",
  "algorithm": "SHA-256",
  "canonicalization": "RFC8785_JSON_CANONICALIZATION_SCHEME",
  "encoding": "UTF-8",
  "checkedInFileRule": "SHA256_OF_EXACT_RAW_BYTES",
  "generatedEnvelopeRule": "RFC8785_WITH_DESIGNATED_SELF_HASH_FIELD_NULL",
  "selfHashRule": "SET_DESIGNATED_FIELD_TO_NULL_BEFORE_CANONICALIZATION",
  "projectionHashRules": {
    "selectedRecipeSha256": "SHA256_OF_RFC8785_CANONICAL_SELECTED_FORMATIVE_OR_HOLDOUT_ROW",
    "goldReplayBuildInputs": "SHA256_OF_RFC8785_PATH_RAW_SHA256_BYTE_LENGTH_ROWS_FOR_CANDIDATE_OWNED_GOLD_REPLAY_INPUTS_IN_EXACT_DECLARED_ORDER"
  },
  "bindings": [
    {
      "artifactSchema": "cold-actor-response.schema.json",
      "field": "coldActorResponseSha256",
      "producer": "COLD_ACTOR_TRANSPORT"
    },
    {
      "artifactSchema": "actor-trace.schema.json",
      "field": "actorTraceSha256",
      "producer": "HARNESS_FINAL_PACKAGER"
    },
    {
      "artifactSchema": "evidence-set.schema.json",
      "field": "evidenceSetSha256",
      "producer": "EVIDENCE_SET_PACKAGER"
    },
    {
      "artifactSchema": "qualification-input.schema.json",
      "field": "judgeInputSha256",
      "producer": "QUALIFICATION_INPUT_PACKAGER"
    },
    {
      "artifactSchema": "native-evidence-verification-input.schema.json",
      "field": "verificationInputSha256",
      "producer": "VERIFICATION_INPUT_PACKAGER"
    },
    {
      "artifactSchema": "candidate-judge-input.schema.json",
      "field": "judgeInputSha256",
      "producer": "CANDIDATE_JUDGE_INPUT_PACKAGER"
    },
    {
      "artifactSchema": "candidate-manifest.schema.json",
      "field": "candidateManifestSha256",
      "producer": "CANDIDATE_MANIFEST_PACKAGER"
    },
    {
      "artifactSchema": "evaluation-run-manifest.schema.json",
      "field": "evaluationRunManifestSha256",
      "producer": "EVALUATION_RUN_PACKAGER"
    },
    {
      "artifactSchema": "coverage-trace.schema.json",
      "field": "coverageArtifactId",
      "producer": "COVERAGE_FINAL_PACKAGER"
    },
    {
      "artifactSchema": "coverage-action-ledger.schema.json",
      "field": "coverageActionLedgerSha256",
      "producer": "COVERAGE_ACTION_LEDGER_PACKAGER"
    },
    {
      "artifactSchema": "qualification-receipt.schema.json",
      "field": "qualificationReceiptSha256",
      "producer": "QUALIFICATION_RECEIPT_PACKAGER"
    },
    {
      "artifactSchema": "judge-panel.schema.json",
      "field": "judgePanelSha256",
      "producer": "JUDGE_PANEL_PACKAGER"
    },
    {
      "artifactSchema": "holdout-consumption-receipt.schema.json",
      "field": "holdoutConsumptionReceiptSha256",
      "producer": "HOLDOUT_CONSUMPTION_PACKAGER"
    },
    {
      "artifactSchema": "holdout-consumption-registry.schema.json",
      "field": "holdoutConsumptionRegistrySha256",
      "producer": "HOLDOUT_CONSUMPTION_PACKAGER"
    },
    {
      "artifactSchema": "evaluation-session-claim.schema.json",
      "field": "evaluationSessionClaimSha256",
      "producer": "EVALUATION_SESSION_CLAIM_PACKAGER"
    },
    {
      "artifactSchema": "evaluation-attempt-receipt.schema.json",
      "field": "evaluationAttemptReceiptSha256",
      "producer": "EVALUATION_ATTEMPT_LEDGER"
    },
    {
      "artifactSchema": "evaluation-attempt-terminal.schema.json",
      "field": "evaluationAttemptTerminalSha256",
      "producer": "EVALUATION_ATTEMPT_LEDGER"
    },
    {
      "artifactSchema": "gold-binding-manifest.schema.json",
      "field": "goldBindingManifestSha256",
      "producer": "GOLD_BINDING_PACKAGER"
    },
    {
      "artifactSchema": "anonymization-manifest.schema.json",
      "field": "anonymizationManifestSha256",
      "producer": "ANONYMIZATION_PACKAGER"
    },
    {
      "artifactSchema": "sanitized-evidence-bundle-manifest.schema.json",
      "field": "sanitizedEvidenceBundleManifestSha256",
      "producer": "EVIDENCE_SET_PACKAGER"
    },
    {
      "artifactSchema": "recording-manifest.schema.json",
      "field": "recordingManifestSha256",
      "producer": "ACTOR_RECORDING_PACKAGER"
    },
    {
      "artifactSchema": "recording-manifest.schema.json",
      "field": "recordingManifestSha256",
      "producer": "COVERAGE_RECORDING_PACKAGER"
    },
    {
      "artifactSchema": "panel-finalization-seal.schema.json",
      "field": "panelFinalizationSealSha256",
      "producer": "PANEL_FINALIZATION_SEAL_PACKAGER"
    }
  ],
  "postRunActorFields": [
    "coldActorResponseSha256",
    "coldActorResponseRawSha256",
    "userDataSha256",
    "saveSha256",
    "journalSha256",
    "recordingManifestSha256",
    "recordingManifestRawSha256",
    "actorArtifactId",
    "actorTraceSha256"
  ],
  "verification": {
    "requireExactRecomputation": true,
    "rejectMissingOrMismatch": true,
    "hardGate": "HG13-PROVENANCE"
  }
}
