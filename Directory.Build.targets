<Project>
  <Target Name="RejectCurrentR2ExportDebug"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'ExportDebug'">
    <Error Text="ExportDebug is disabled. Use Debug or Release for current development, or the explicitly selected ExportRelease graph for an authorized package." />
  </Target>

  <Target Name="RequireExplicitExportReleaseGraph"
          BeforeTargets="CheckForDuplicateItems;PrepareForBuild"
          Condition="'$(Configuration)' == 'ExportRelease'">
    <Error Condition="'$(GridworksCurrentR2Export)' != 'true' and '$(GridworksLegacyV2Export)' != 'true'"
           Text="ExportRelease requires exactly one explicit graph selector: GridworksCurrentR2Export=true or GridworksLegacyV2Export=true." />
    <Error Condition="'$(GridworksCurrentR2Export)' == 'true' and '$(GridworksLegacyV2Export)' == 'true'"
           Text="ExportRelease cannot select both current R2 and frozen legacy V2. Set exactly one of GridworksCurrentR2Export=true or GridworksLegacyV2Export=true." />
  </Target>
</Project>
