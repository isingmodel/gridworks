{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/commercial-ux-holdout-consumption-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocol", "holdoutConsumptionReceiptSha256",
    "holdoutConsumptionReceiptSchemaSha256", "candidateId", "candidateManifestSha256",
    "candidateReuseSha256", "candidatePlayableFingerprintSha256",
    "sourceCommit", "evaluationPhase", "officialCommercialUX", "holdoutQueueSha256",
    "queueAuthorityId", "registryScope", "registryAuthorityLimit",
    "selectionRule", "reuseAllowed", "selectedRecipe", "priorConsumptions",
    "atomicClaim", "status"
  ],
  "properties": {
    "schemaVersion": {"const": "gridworks.commercial-ux.holdout-consumption-receipt.v1"},
    "protocol": {"const": "GRIDWORKS-COMMERCIAL-UX-v1.1"},
    "holdoutConsumptionReceiptSha256": {"$ref": "#/$defs/sha256"},
    "holdoutConsumptionReceiptSchemaSha256": {"$ref": "#/$defs/sha256"},
    "candidateId": {"type": "string", "minLength": 1, "maxLength": 200},
    "candidateManifestSha256": {"$ref": "#/$defs/sha256"},
    "candidateReuseSha256": {"$ref": "#/$defs/sha256"},
    "candidatePlayableFingerprintSha256": {"$ref": "#/$defs/sha256"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evaluationPhase": {"enum": ["FORMATIVE", "OFFICIAL_HOLDOUT"]},
    "officialCommercialUX": {"type": "boolean"},
    "holdoutQueueSha256": {"$ref": "#/$defs/sha256"},
    "queueAuthorityId": {"const": "GRIDWORKS-COMMERCIAL-UX-HOLDOUT-QUEUE-v1.1"},
    "registryScope": {"const": "LOCAL_REPOSITORY_REGISTRY_ONLY"},
    "registryAuthorityLimit": {"const": "NOT_GLOBAL_ACROSS_REPOSITORY_CLONES"},
    "selectionRule": {"const": "LOWEST_UNUSED_ORDINAL"},
    "reuseAllowed": {"const": false},
    "selectedRecipe": {"$ref": "#/$defs/selectedRecipe"},
    "priorConsumptions": {
      "type": "array", "maxItems": 7, "uniqueItems": true,
      "items": {"$ref": "#/$defs/priorConsumption"}
    },
    "atomicClaim": {"$ref": "#/$defs/atomicClaim"},
    "status": {"const": "CONSUMED"}
  },
  "allOf": [{
    "if": {"properties": {"evaluationPhase": {"const": "FORMATIVE"}}, "required": ["evaluationPhase"]},
    "then": {
      "properties": {
        "officialCommercialUX": {"const": false},
        "selectedRecipe": {"properties": {"recipeId": {"const": "FORMATIVE-01"}, "ordinal": {"type": "null"}, "missionPrototypeBits": {"const": "001"}, "routeFamily": {"const": "NATIVE_SMOKE_WITNESS"}}},
        "priorConsumptions": {"maxItems": 0}
      }
    },
    "else": {
      "properties": {
        "officialCommercialUX": {"const": true},
        "selectedRecipe": {"properties": {"recipeId": {"pattern": "^HOLDOUT-0[1-8]$"}, "ordinal": {"type": "integer", "minimum": 1, "maximum": 8}, "missionPrototypeBits": {"pattern": "^[01]{3}$"}, "routeFamily": {"type": "null"}}}
      }
    }
  }],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "selectedRecipe": {
      "type": "object", "additionalProperties": false,
      "required": [
        "recipeId", "ordinal", "selectedRecipeSha256", "missionPrototypeBits",
        "routeFamily", "promiseBranchOrder", "actorArtifactPermutation",
        "coverageArtifactOrder", "coveragePresentationEpisodeIds"
      ],
      "properties": {
        "recipeId": {"pattern": "^(FORMATIVE-01|HOLDOUT-0[1-8])$"},
        "ordinal": {"type": ["integer", "null"], "minimum": 1, "maximum": 8},
        "selectedRecipeSha256": {"$ref": "#/$defs/sha256"},
        "missionPrototypeBits": {"type": "string", "pattern": "^[01]{3}$"},
        "routeFamily": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{1,79}$"},
        "promiseBranchOrder": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["keep", "defer"]}
        },
        "actorArtifactPermutation": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 2}
        },
        "coverageArtifactOrder": {"enum": ["EPISODE_ASCENDING", "EPISODE_DESCENDING"]}
        ,"coveragePresentationEpisodeIds": {
          "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
          "items": {"pattern": "^E(0[0-9]|1[01])-[A-Z0-9-]+$"}
        }
      }
    },
    "priorConsumption": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ordinal", "recipeId", "candidateReuseSha256", "candidatePlayableFingerprintSha256", "candidateManifestSha256",
        "sourceCommit", "transactionId"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 7},
        "recipeId": {"pattern": "^HOLDOUT-0[1-7]$"},
        "candidateReuseSha256": {"$ref": "#/$defs/sha256"},
        "candidatePlayableFingerprintSha256": {"$ref": "#/$defs/sha256"},
        "candidateManifestSha256": {"$ref": "#/$defs/sha256"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "transactionId": {"$ref": "#/$defs/sha256"}
      }
    },
    "atomicClaim": {
      "type": "object", "additionalProperties": false,
      "required": [
        "claimPolicy", "queuePreflightStatus", "registryInputPath", "canonicalRegistryPath",
        "receiptInputPath", "canonicalReceiptPath", "transactionId",
        "registryPathRule", "receiptPathRule", "receiptCreatePolicy",
        "registryBeforeSha256", "registryBeforeRawSha256",
        "registryAfterSha256", "registryAfterRawSha256", "priorConsumptionSetSha256",
        "lockAcquired", "receiptExclusiveCreateCompleted", "receiptFsyncCompleted",
        "fsyncCompleted", "atomicRenameCompleted"
      ],
      "properties": {
        "claimPolicy": {"const": "LOCKED_LOCAL_REGISTRY_COMPARE_LOWEST_UNUSED_APPEND_FSYNC_ATOMIC_RENAME_BEFORE_ANY_ACTOR_OR_JUDGE_EXPOSURE"},
        "queuePreflightStatus": {"const": "EXACT_BEFORE_CLAIM"},
        "registryInputPath": {"$ref": "#/$defs/absolutePath"},
        "canonicalRegistryPath": {"$ref": "#/$defs/absolutePath"},
        "receiptInputPath": {"$ref": "#/$defs/absolutePath"},
        "canonicalReceiptPath": {"$ref": "#/$defs/absolutePath"},
        "transactionId": {"$ref": "#/$defs/sha256"},
        "registryPathRule": {"const": "GIT_COMMON_DIR/gridworks-commercial-ux/holdout-consumption-registry-v1.json"},
        "receiptPathRule": {"const": "GIT_COMMON_DIR/gridworks-commercial-ux/holdout-receipts/{transactionSha256Hex}-{candidatePlayableFingerprintSha256Hex}.json"},
        "receiptCreatePolicy": {"const": "O_EXCL_CREATE_AND_FSYNC_BEFORE_ATOMIC_REGISTRY_RENAME"},
        "registryBeforeSha256": {"$ref": "#/$defs/sha256"},
        "registryBeforeRawSha256": {"$ref": "#/$defs/sha256"},
        "registryAfterSha256": {"$ref": "#/$defs/sha256"},
        "registryAfterRawSha256": {"$ref": "#/$defs/sha256"},
        "priorConsumptionSetSha256": {"$ref": "#/$defs/sha256"},
        "lockAcquired": {"const": true},
        "receiptExclusiveCreateCompleted": {"const": true},
        "receiptFsyncCompleted": {"const": true},
        "fsyncCompleted": {"const": true},
        "atomicRenameCompleted": {"const": true}
      }
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000/]+(?:/[^\\u0000/]+)*$",
      "maxLength": 1000
    }
  }
}
