{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/commercial-ux-native-actor-trace-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "actorTraceSha256",
    "actorArtifactId",
    "coldActorResponseSha256",
    "coldActorResponseRawSha256",
    "actorObservationSha256",
    "observation",
    "promptTemplateSha256",
    "actorObservationSchemaSha256",
    "actorTraceSchemaSha256",
    "conceptManifestSha256",
    "recipeId",
    "recipeSha256",
    "candidateManifestSha256",
    "holdoutConsumptionReceiptSha256",
    "goldBindingManifestSha256",
    "actorCaptureSlot",
    "executionArtifactSha256",
    "userDataSha256",
    "saveSha256",
    "journalSha256",
    "recordingManifestSha256",
    "recordingManifestRawSha256",
    "processTreeId",
    "packagerId"
  ],
  "properties": {
    "schemaVersion": {"const": "gridworks.commercial-ux.native-actor-trace.v1"},
    "protocol": {"const": "GRIDWORKS-COMMERCIAL-UX-v1.1"},
    "actorTraceSha256": {"$ref": "#/$defs/sha256"},
    "actorArtifactId": {"$ref": "#/$defs/sha256"},
    "coldActorResponseSha256": {"$ref": "#/$defs/sha256"},
    "coldActorResponseRawSha256": {"$ref": "#/$defs/sha256"},
    "actorObservationSha256": {"$ref": "#/$defs/sha256"},
    "observation": {"$ref": "actor-observation.schema.json"},
    "promptTemplateSha256": {"$ref": "#/$defs/sha256"},
    "actorObservationSchemaSha256": {"$ref": "#/$defs/sha256"},
    "actorTraceSchemaSha256": {"$ref": "#/$defs/sha256"},
    "conceptManifestSha256": {"$ref": "#/$defs/sha256"},
    "recipeId": {"const": "COLD-JOURNEY-v1"},
    "recipeSha256": {"$ref": "#/$defs/sha256"},
    "candidateManifestSha256": {"$ref": "#/$defs/sha256"},
    "holdoutConsumptionReceiptSha256": {"$ref": "#/$defs/sha256"},
    "goldBindingManifestSha256": {"$ref": "#/$defs/sha256"},
    "actorCaptureSlot": {"type": "integer", "minimum": 0, "maximum": 2},
    "executionArtifactSha256": {"$ref": "#/$defs/sha256"},
    "userDataSha256": {"$ref": "#/$defs/sha256"},
    "saveSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "journalSha256": {"$ref": "#/$defs/sha256"},
    "recordingManifestSha256": {"$ref": "#/$defs/sha256"},
    "recordingManifestRawSha256": {"$ref": "#/$defs/sha256"},
    "processTreeId": {"type": "string", "minLength": 1, "maxLength": 200},
    "packagerId": {"const": "HARNESS_FINAL_PACKAGER"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
