<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <!-- Shared deterministic export settings; selectors below choose one graph. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/src/Gridworks.Core</PathMap>
  </PropertyGroup>

  <!-- The regular project is the current R2 Core graph: its strict V2 base plus V3 realtime rules. -->
  <ItemGroup Condition="'$(Configuration)' != 'ExportRelease' or ('$(GridworksCurrentR2Export)' == 'true' and '$(GridworksLegacyV2Export)' != 'true')">
    <Compile Include="Release/V2/**/*.cs" />
    <Compile Include="Release/V3/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'ExportRelease' and '$(GridworksLegacyV2Export)' == 'true' and '$(GridworksCurrentR2Export)' != 'true'">
    <Compile Include="Release/V2/**/*.cs" />
  </ItemGroup>
</Project>
