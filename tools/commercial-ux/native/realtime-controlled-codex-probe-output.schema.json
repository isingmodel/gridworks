{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/realtime-controlled-codex-probe-output.schema.json",
  "title": "Gridworks controlled Codex non-score probe output",
  "$comment": "STRUCTURED OUTPUT CONTRACT ONLY. This echo is not model identity, platform attestation, evidence, judgment, aggregation, or score authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "probe",
    "nonce",
    "parentEvaluationChainClaimRawSha256",
    "parentAggregateRawSha256",
    "blockedJudgeInputRawSha256",
    "modelEcho",
    "reasoningEffortEcho",
    "acknowledged",
    "officialCommercialUX",
    "commercialUXProxy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "gridworks.realtime-controlled-codex-probe-output.v1"
    },
    "probe": {
      "type": "string",
      "const": "GRIDWORKS_CONTROLLED_CODEX_TRANSCRIPT_NON_SCORE_V1"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parentEvaluationChainClaimRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "parentAggregateRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "blockedJudgeInputRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "modelEcho": {
      "type": "string",
      "const": "gpt-5.6-sol"
    },
    "reasoningEffortEcho": {
      "type": "string",
      "const": "ultra"
    },
    "acknowledged": {
      "type": "boolean",
      "const": true
    },
    "officialCommercialUX": {
      "type": "boolean",
      "const": false
    },
    "commercialUXProxy": {
      "type": "null"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
