{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/commercial-ux-native-coverage-trace-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocol", "coverageArtifactId", "candidateManifestSha256",
    "executionArtifactSha256", "coverageRecipeSha256", "holdoutQueueSha256",
    "selectedRecipeId", "selectedRecipeSha256", "conceptManifestSha256",
    "goldBindingManifestSha256", "processTreeId", "runnerId", "userDataSha256",
    "journalBundleSha256", "recordingManifestSha256", "episodes"
  ],
  "properties": {
    "schemaVersion": {"const": "gridworks.commercial-ux.native-coverage-trace.v1"},
    "protocol": {"const": "GRIDWORKS-COMMERCIAL-UX-v1.1"},
    "coverageArtifactId": {"$ref": "#/$defs/sha256"},
    "candidateManifestSha256": {"$ref": "#/$defs/sha256"},
    "executionArtifactSha256": {"$ref": "#/$defs/sha256"},
    "coverageRecipeSha256": {"$ref": "#/$defs/sha256"},
    "holdoutQueueSha256": {"$ref": "#/$defs/sha256"},
    "selectedRecipeId": {"pattern": "^(FORMATIVE-01|HOLDOUT-0[1-8])$"},
    "selectedRecipeSha256": {"$ref": "#/$defs/sha256"},
    "conceptManifestSha256": {"$ref": "#/$defs/sha256"},
    "goldBindingManifestSha256": {"$ref": "#/$defs/sha256"},
    "processTreeId": {"type": "string", "minLength": 1, "maxLength": 200},
    "runnerId": {"const": "COVERAGE_FINAL_PACKAGER"},
    "userDataSha256": {"$ref": "#/$defs/sha256"},
    "journalBundleSha256": {"$ref": "#/$defs/sha256"},
    "recordingManifestSha256": {"$ref": "#/$defs/sha256"},
    "episodes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E00-TITLE"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E01-FIRST-LIGHT"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E02-SECOND-HEART"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E03-SECOND-SOURCE"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E04-NORTH-BANK"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E05-WHOSE-MARGIN"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E06-FLOOD"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E07-MAINTENANCE"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E08-FINALE"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E09-MID-RESUME"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E10-COMPLETE-RESUME"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E11-AUTHORED-TEXT"}}}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "episodeId": {
      "enum": [
        "E00-TITLE", "E01-FIRST-LIGHT", "E02-SECOND-HEART", "E03-SECOND-SOURCE",
        "E04-NORTH-BANK", "E05-WHOSE-MARGIN", "E06-FLOOD", "E07-MAINTENANCE",
        "E08-FINALE", "E09-MID-RESUME", "E10-COMPLETE-RESUME", "E11-AUTHORED-TEXT"
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "sha256", "mimeType", "locator"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["FRAME", "VIDEO", "AUDIO", "ACTION_LEDGER", "VISIBLE_TEXT"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mimeType": {"type": "string", "minLength": 1, "maxLength": 100},
        "locator": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "traceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traceRowId", "checkpoint", "actionOccurrenceId", "semanticActionKind", "actionIndex",
        "preStateSha256", "postStateSha256", "visibleFeedback", "audibleFeedback",
        "artifactRefs"
      ],
      "properties": {
        "traceRowId": {"type": "string", "pattern": "^TRACE-[0-9]{4}$"},
        "checkpoint": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,99}$"},
        "actionOccurrenceId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,119}$"},
        "semanticActionKind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,99}$"},
        "actionIndex": {"type": "integer", "minimum": 0, "maximum": 4096},
        "preStateSha256": {"$ref": "#/$defs/sha256"},
        "postStateSha256": {"$ref": "#/$defs/sha256"},
        "visibleFeedback": {"type": "string", "minLength": 1, "maxLength": 1000},
        "audibleFeedback": {"type": "string", "maxLength": 1000},
        "artifactRefs": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactRef"}
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episodeId", "prefixId", "checkpointIds", "actionLedgerSha256",
        "traceRows", "mediaArtifacts", "terminalState", "terminalIncidentKey"
      ],
      "properties": {
        "episodeId": {"$ref": "#/$defs/episodeId"},
        "prefixId": {"type": "string", "pattern": "^PREFIX-[A-Z0-9-]+$"},
        "checkpointIds": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,99}$"}
        },
        "actionLedgerSha256": {"$ref": "#/$defs/sha256"},
        "traceRows": {
          "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
          "items": {"$ref": "#/$defs/traceRow"}
        },
        "mediaArtifacts": {
          "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactRef"}
        },
        "terminalState": {"const": "COMPLETED"},
        "terminalIncidentKey": {"type": "null"}
      }
    }
  }
}
