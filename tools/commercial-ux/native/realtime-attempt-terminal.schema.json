{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/realtime-evaluation-attempt-terminal-v1.json",
  "title": "Gridworks realtime diagnostic evaluation attempt terminal receipt",
  "$comment": "STRUCTURAL VALIDATION ONLY; NON-AUTHORITATIVE. Schema success never establishes a terminal outcome, output integrity, retry authority, session, candidate, route, or score authority. Consumers MUST reconstruct the receipt from the finalized claim, start receipt, and exact output bytes. evaluationAttemptTerminalSha256 is SHA-256 of GRIDWORKS_CANONICAL_JSON_V1 bytes for this object with evaluationAttemptTerminalSha256 omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalization",
    "attemptTerminalSchemaRawSha256",
    "sessionPolicyRawSha256",
    "sessionId",
    "sessionClaimSha256",
    "sessionClaimRawSha256",
    "candidateSha256",
    "routeBindingSha256",
    "routeKind",
    "attemptOrdinal",
    "attemptId",
    "evaluationAttemptStartSha256",
    "attemptStartReceiptRawSha256",
    "canonicalOutputPath",
    "outputRawSha256",
    "outputCanonicalSha256",
    "outputByteLength",
    "expectedOutputRawSha256",
    "outcome",
    "outcomeRetryable",
    "nextAttemptAllowed",
    "canonicalTerminalReceiptPath",
    "terminalizationAuthority",
    "officialCommercialUX",
    "scoreBearingCaptureAllowed",
    "evaluationAttemptTerminalSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gridworks.realtime-evaluation-attempt-terminal.v1"
    },
    "canonicalization": {
      "const": "GRIDWORKS_CANONICAL_JSON_V1"
    },
    "attemptTerminalSchemaRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sessionPolicyRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sessionId": {
      "$ref": "#/$defs/sha256"
    },
    "sessionClaimSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sessionClaimRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidateSha256": {
      "const": "sha256:373785e45a4485dfeded43466a5bff0f66de4a0c106c972262686e7a432cbdd6"
    },
    "routeBindingSha256": {
      "$ref": "#/$defs/sha256"
    },
    "routeKind": {
      "enum": [
        "TARGETED_CHECKPOINT",
        "STORY_PART_UNIT"
      ]
    },
    "attemptOrdinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "attemptId": {
      "$ref": "#/$defs/sha256"
    },
    "evaluationAttemptStartSha256": {
      "$ref": "#/$defs/sha256"
    },
    "attemptStartReceiptRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "canonicalOutputPath": {
      "allOf": [
        {"$ref": "#/$defs/absolutePath"},
        {"type": "string", "pattern": "/attempts/(?:01|02|03)/diagnostic-output\\.json$"}
      ]
    },
    "outputRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "outputCanonicalSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "outputByteLength": {
      "type": "integer",
      "minimum": 0
    },
    "expectedOutputRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "outcome": {
      "enum": [
        "PRODUCER_NO_OUTPUT",
        "TRANSPORT_FAILURE",
        "SUCCESS",
        "INTEGRITY_FAILURE"
      ]
    },
    "outcomeRetryable": {
      "type": "boolean"
    },
    "nextAttemptAllowed": {
      "type": "boolean"
    },
    "canonicalTerminalReceiptPath": {
      "allOf": [
        {"$ref": "#/$defs/absolutePath"},
        {"type": "string", "pattern": "/attempts/(?:01|02|03)/terminal-receipt\\.json$"}
      ]
    },
    "terminalizationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminalPathAbsentBeforeReservation",
        "terminalZeroByteReservedBeforeOutputRead",
        "terminalReceiptFinalizedWithFsync",
        "callerSuppliedOutcomeAccepted"
      ],
      "properties": {
        "terminalPathAbsentBeforeReservation": {"const": true},
        "terminalZeroByteReservedBeforeOutputRead": {"const": true},
        "terminalReceiptFinalizedWithFsync": {"const": true},
        "callerSuppliedOutcomeAccepted": {"const": false}
      }
    },
    "officialCommercialUX": {
      "const": false
    },
    "scoreBearingCaptureAllowed": {
      "const": false
    },
    "evaluationAttemptTerminalSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {"const": "PRODUCER_NO_OUTPUT"},
        "outputCanonicalSha256": {"type": "null"},
        "outputByteLength": {"const": 0},
        "outcomeRetryable": {"const": true}
      }
    },
    {
      "properties": {
        "outcome": {"const": "TRANSPORT_FAILURE"},
        "outputCanonicalSha256": {"type": "null"},
        "outputByteLength": {"type": "integer", "minimum": 1},
        "outcomeRetryable": {"const": true}
      }
    },
    {
      "properties": {
        "outcome": {"const": "SUCCESS"},
        "outputCanonicalSha256": {"$ref": "#/$defs/sha256"},
        "outputByteLength": {"type": "integer", "minimum": 1},
        "outcomeRetryable": {"const": false},
        "nextAttemptAllowed": {"const": false}
      }
    },
    {
      "properties": {
        "outcome": {"const": "INTEGRITY_FAILURE"},
        "outputCanonicalSha256": {"$ref": "#/$defs/sha256"},
        "outputByteLength": {"type": "integer", "minimum": 1},
        "outcomeRetryable": {"const": false},
        "nextAttemptAllowed": {"const": false}
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcomeRetryable": {"const": true}
        },
        "required": ["outcomeRetryable"]
      },
      "then": {
        "if": {
          "properties": {
            "attemptOrdinal": {"const": 3}
          },
          "required": ["attemptOrdinal"]
        },
        "then": {
          "properties": {
            "nextAttemptAllowed": {"const": false}
          }
        },
        "else": {
          "properties": {
            "nextAttemptAllowed": {"const": true}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:/\\.\\.?)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f])[^\\u0000]+$"
    }
  }
}
