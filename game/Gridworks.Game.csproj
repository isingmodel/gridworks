<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Gridworks.Game</RootNamespace>
    <AssemblyName>Gridworks.Game</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Gridworks.Core/Gridworks.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../data/product-campaign-v1.json"
                      Link="EmbeddedData/product-campaign-v1.json"
                      LogicalName="Gridworks.Game.EmbeddedData.product-campaign-v1.json" />
    <EmbeddedResource Include="../data/product-heatwave-v1.json"
                      Link="EmbeddedData/product-heatwave-v1.json"
                      LogicalName="Gridworks.Game.EmbeddedData.product-heatwave-v1.json" />
    <EmbeddedResource Include="../data/release-world-v1.json"
                      Link="EmbeddedData/release-world-v1.json"
                      LogicalName="Gridworks.Game.EmbeddedData.release-world-v1.json" />
  </ItemGroup>
</Project>
