{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/realtime-evaluation-session-claim-v1.json",
  "title": "Gridworks realtime diagnostic evaluation session claim",
  "$comment": "STRUCTURAL VALIDATION ONLY; NON-AUTHORITATIVE. Schema success never establishes session, candidate, Git, route, filesystem, freshness, native UX, evidence, score, or retry authority. Consumers MUST run verify_session_claim_against_reconstructed_authority, which independently reconstructs the fixed candidate, session evaluator Git blobs, policy, snapshots, route, paths, hashes, and exact bytes. sessionClaimSha256 is SHA-256 of GRIDWORKS_CANONICAL_JSON_V1 bytes for this object with sessionClaimSha256 omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalization",
    "status",
    "sessionPolicyRawSha256",
    "sessionClaimSchemaRawSha256",
    "sessionAuthoritySourceCommit",
    "sessionEvaluatorAuthority",
    "sessionId",
    "sessionNonce",
    "canonicalSessionRoot",
    "canonicalClaimPath",
    "sessionRootBindingSha256",
    "candidateAuthority",
    "routeBinding",
    "routeDisposition",
    "unavailableRouteTerminal",
    "expectedAttemptOutput",
    "attemptPolicy",
    "attempts",
    "finalizationAuthority",
    "officialCommercialUX",
    "scoreBearingCaptureAllowed",
    "claimProducerExecutionAttested",
    "freshnessAuthority",
    "limitations",
    "sessionClaimSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gridworks.realtime-evaluation-session-claim.v1"
    },
    "canonicalization": {
      "const": "GRIDWORKS_CANONICAL_JSON_V1"
    },
    "status": {
      "const": "FINALIZED_BEFORE_ANY_ATTEMPT"
    },
    "sessionPolicyRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sessionClaimSchemaRawSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sessionAuthoritySourceCommit": {
      "$ref": "#/$defs/gitCommit"
    },
    "sessionEvaluatorAuthority": {
      "$ref": "#/$defs/sessionEvaluatorAuthority"
    },
    "sessionId": {
      "$ref": "#/$defs/sha256"
    },
    "sessionNonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalSessionRoot": {
      "$ref": "#/$defs/absolutePath"
    },
    "canonicalClaimPath": {
      "allOf": [
        {"$ref": "#/$defs/absolutePath"},
        {"type": "string", "pattern": "/session-claim\\.json$"}
      ]
    },
    "sessionRootBindingSha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidateAuthority": {
      "$ref": "#/$defs/candidateAuthority"
    },
    "routeBinding": {
      "oneOf": [
        {"$ref": "#/$defs/targetedCheckpointRouteBinding"},
        {"$ref": "#/$defs/storyPartRouteBinding"},
        {"$ref": "#/$defs/fullFlowRouteBinding"}
      ]
    },
    "routeDisposition": {
      "enum": [
        "DIAGNOSTIC_ATTEMPT_AUTHORIZED",
        "CONTENT_UNIT_ATTEMPT_AUTHORIZED",
        "ROUTE_UNAVAILABLE_NO_EXECUTION"
      ]
    },
    "unavailableRouteTerminal": {
      "oneOf": [
        {"$ref": "#/$defs/unavailableRouteTerminal"},
        {"type": "null"}
      ]
    },
    "expectedAttemptOutput": {
      "oneOf": [
        {"$ref": "#/$defs/expectedAttemptOutput"},
        {"type": "null"}
      ]
    },
    "attemptPolicy": {
      "$ref": "#/$defs/attemptPolicy"
    },
    "attempts": {
      "oneOf": [
        {"$ref": "#/$defs/plannedAttempts"},
        {"type": "array", "maxItems": 0}
      ]
    },
    "finalizationAuthority": {
      "$ref": "#/$defs/finalizationAuthority"
    },
    "officialCommercialUX": {
      "const": false
    },
    "scoreBearingCaptureAllowed": {
      "const": false
    },
    "claimProducerExecutionAttested": {
      "const": false
    },
    "freshnessAuthority": {
      "const": "LOCAL_OS_RANDOM_NON_SCORE_ONLY"
    },
    "limitations": {
      "const": [
        "NO_INTERACTIVE_NATIVE_CAPTURE",
        "FULL_FLOW_UNAVAILABLE_NOT_IMPLEMENTED",
        "STORY_PART_UNIT_IS_NOT_NATIVE_REACHABILITY",
        "FUTURE_EVENT_STATUS_BAR_NATIVE_QUALITY_NOT_OBSERVED",
        "LOCAL_NONCE_IS_NOT_PLATFORM_FRESHNESS_RECEIPT",
        "CLAIM_PRODUCER_EXECUTION_NOT_EXTERNALLY_ATTESTED",
        "PYTHON_STDLIB_OS_TRUST_BASE_UNBOUND",
        "SCORE_BEARING_CAPTURE_FORBIDDEN"
      ]
    },
    "sessionClaimSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "routeBinding": {
            "type": "object",
            "properties": {
              "routeKind": {"const": "TARGETED_CHECKPOINT"}
            },
            "required": ["routeKind"]
          }
        },
        "required": ["routeBinding"]
      },
      "then": {
        "properties": {
          "routeDisposition": {"const": "DIAGNOSTIC_ATTEMPT_AUTHORIZED"},
          "unavailableRouteTerminal": {"type": "null"},
          "expectedAttemptOutput": {"$ref": "#/$defs/expectedAttemptOutput"},
          "attemptPolicy": {
            "allOf": [
              {"$ref": "#/$defs/attemptPolicy"},
              {"type": "object", "properties": {"maxAttempts": {"const": 3}}}
            ]
          },
          "attempts": {"$ref": "#/$defs/plannedAttempts"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "routeBinding": {
            "type": "object",
            "properties": {
              "routeKind": {"const": "STORY_PART_UNIT"}
            },
            "required": ["routeKind"]
          }
        },
        "required": ["routeBinding"]
      },
      "then": {
        "properties": {
          "routeDisposition": {"const": "CONTENT_UNIT_ATTEMPT_AUTHORIZED"},
          "unavailableRouteTerminal": {"type": "null"},
          "expectedAttemptOutput": {"$ref": "#/$defs/expectedAttemptOutput"},
          "attemptPolicy": {
            "allOf": [
              {"$ref": "#/$defs/attemptPolicy"},
              {"type": "object", "properties": {"maxAttempts": {"const": 3}}}
            ]
          },
          "attempts": {"$ref": "#/$defs/plannedAttempts"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "routeBinding": {
            "type": "object",
            "properties": {
              "routeKind": {"const": "FULL_FLOW_EXCEPTION"}
            },
            "required": ["routeKind"]
          }
        },
        "required": ["routeBinding"]
      },
      "then": {
        "properties": {
          "routeDisposition": {"const": "ROUTE_UNAVAILABLE_NO_EXECUTION"},
          "unavailableRouteTerminal": {"$ref": "#/$defs/unavailableRouteTerminal"},
          "expectedAttemptOutput": {"type": "null"},
          "attemptPolicy": {
            "allOf": [
              {"$ref": "#/$defs/attemptPolicy"},
              {"type": "object", "properties": {"maxAttempts": {"const": 0}}}
            ]
          },
          "attempts": {"type": "array", "maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:/\\.\\.?)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f])[^\\u0000]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])[^\\u0000]+$"
    },
    "sessionEvaluatorAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourceCommit",
        "fileCount",
        "files",
        "filesSha256",
        "runningFilesMatchGitBlobs",
        "gitCommandAuthority",
        "candidateSemanticVerifierDependencyBound",
        "semanticVerifierEntryPoint",
        "structuralSchemasAuthority"
      ],
      "properties": {
        "schemaVersion": {"const": "gridworks.realtime-session-producer-authority.v1"},
        "sourceCommit": {"$ref": "#/$defs/gitCommit"},
        "fileCount": {"const": 7},
        "files": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/sessionEvaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"const": "tools/commercial-ux/native/build-realtime-candidate-authority.py"},
                  "role": {"const": "BOUND_CANDIDATE_SEMANTIC_VERIFIER_DEPENDENCY"}
                }}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/sessionEvaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"const": "tools/commercial-ux/native/realtime-attempt-start.schema.json"},
                  "role": {"const": "STRUCTURAL_ATTEMPT_START_SCHEMA_NON_AUTHORITY"}
                }}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/sessionEvaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"const": "tools/commercial-ux/native/realtime-attempt-terminal.schema.json"},
                  "role": {"const": "STRUCTURAL_ATTEMPT_TERMINAL_SCHEMA_NON_AUTHORITY"}
                }}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/sessionEvaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"const": "tools/commercial-ux/native/realtime-session-authority.py"},
                  "role": {"const": "SESSION_PRODUCER_AND_SEMANTIC_VERIFIER"}
                }}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/sessionEvaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"const": "tools/commercial-ux/native/realtime-session-claim.schema.json"},
                  "role": {"const": "STRUCTURAL_SESSION_CLAIM_SCHEMA_NON_AUTHORITY"}
                }}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/sessionEvaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"const": "tools/commercial-ux/native/realtime-session-policy.json"},
                  "role": {"const": "SESSION_POLICY"}
                }}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/sessionEvaluatorFile"},
                {"type": "object", "properties": {
                  "path": {"const": "tools/commercial-ux/native/test-realtime-session-authority.py"},
                  "role": {"const": "ADVERSARIAL_SESSION_TEST_SPEC_NON_RUNTIME"}
                }}
              ]
            }
          ],
          "items": false
        },
        "filesSha256": {"$ref": "#/$defs/sha256"},
        "runningFilesMatchGitBlobs": {"const": true},
        "gitCommandAuthority": {"$ref": "#/$defs/gitCommandAuthority"},
        "candidateSemanticVerifierDependencyBound": {"const": true},
        "semanticVerifierEntryPoint": {"const": "verify_session_claim_against_reconstructed_authority"},
        "structuralSchemasAuthority": {"const": "STRUCTURAL_ONLY_NOT_SESSION_AUTHORITY"}
      }
    },
    "sessionEvaluatorFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "gitMode",
        "gitObjectId",
        "rawSha256",
        "byteLength"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "role": {
          "enum": [
            "BOUND_CANDIDATE_SEMANTIC_VERIFIER_DEPENDENCY",
            "STRUCTURAL_ATTEMPT_START_SCHEMA_NON_AUTHORITY",
            "STRUCTURAL_ATTEMPT_TERMINAL_SCHEMA_NON_AUTHORITY",
            "SESSION_PRODUCER_AND_SEMANTIC_VERIFIER",
            "STRUCTURAL_SESSION_CLAIM_SCHEMA_NON_AUTHORITY",
            "SESSION_POLICY",
            "ADVERSARIAL_SESSION_TEST_SPEC_NON_RUNTIME"
          ]
        },
        "gitMode": {"enum": ["100644", "100755"]},
        "gitObjectId": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rawSha256": {"$ref": "#/$defs/sha256"},
        "byteLength": {"type": "integer", "minimum": 1}
      }
    },
    "gitCommandAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256",
        "byteLength",
        "versionOutput",
        "commandBindingScope",
        "allowedReadOnlySubcommands",
        "globalArguments",
        "environment",
        "environmentPolicy",
        "repositoryLocationPolicy",
        "gitDirectoryEntryPolicy",
        "replacementObjectPolicy",
        "lazyFetchPolicy",
        "linkedWorktreeHeadPolicy",
        "objectFormat",
        "objectIdHexLength",
        "systemTrustLimitation",
        "transitiveClosureBound"
      ],
      "properties": {
        "path": {"const": "/Library/Developer/CommandLineTools/usr/bin/git"},
        "rawSha256": {"const": "sha256:be4afb2b003904725826250de9fb76567bbacf82323457b5a1ec26706b66bcae"},
        "byteLength": {"const": 7604272},
        "versionOutput": {"const": "git version 2.50.1 (Apple Git-155)"},
        "commandBindingScope": {"const": "DIRECT_COMMAND_BINARY_BYTES_AND_VERSION_ONLY_TRANSITIVE_CLOSURE_UNBOUND"},
        "allowedReadOnlySubcommands": {"const": ["--version", "cat-file", "ls-tree", "rev-parse"]},
        "globalArguments": {"const": [
          "--no-replace-objects",
          "--no-lazy-fetch",
          "--git-dir=<RESOLVED_GIT_DIRECTORY>",
          "--work-tree=<RESOLVED_REPOSITORY_ROOT>",
          "-c",
          "core.hooksPath=/dev/null"
        ]},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "PATH",
            "LANG",
            "LC_ALL",
            "GIT_CONFIG_GLOBAL",
            "GIT_CONFIG_NOSYSTEM",
            "GIT_CONFIG_SYSTEM",
            "GIT_NO_LAZY_FETCH",
            "GIT_NO_REPLACE_OBJECTS",
            "GIT_OPTIONAL_LOCKS",
            "GIT_TERMINAL_PROMPT"
          ],
          "properties": {
            "PATH": {"const": "/Library/Developer/CommandLineTools/usr/bin:/usr/bin:/bin"},
            "LANG": {"const": "C"},
            "LC_ALL": {"const": "C"},
            "GIT_CONFIG_GLOBAL": {"const": "/dev/null"},
            "GIT_CONFIG_NOSYSTEM": {"const": "1"},
            "GIT_CONFIG_SYSTEM": {"const": "/dev/null"},
            "GIT_NO_LAZY_FETCH": {"const": "1"},
            "GIT_NO_REPLACE_OBJECTS": {"const": "1"},
            "GIT_OPTIONAL_LOCKS": {"const": "0"},
            "GIT_TERMINAL_PROMPT": {"const": "0"}
          }
        },
        "environmentPolicy": {"const": "FRESH_ALLOWLIST_DROPS_AMBIENT_GIT_ENV"},
        "repositoryLocationPolicy": {"const": "EXPLICIT_RESOLVED_GIT_DIR_AND_WORK_TREE"},
        "gitDirectoryEntryPolicy": {"const": "NON_SYMLINK_DIRECTORY_OR_STRICT_GITDIR_FILE_TO_NON_SYMLINK_DIRECTORY"},
        "replacementObjectPolicy": {"const": "DISABLED_BY_CLI_AND_ENV"},
        "lazyFetchPolicy": {"const": "DISABLED_BY_CLI_AND_ENV"},
        "linkedWorktreeHeadPolicy": {"const": "PER_WORKTREE_GIT_DIR"},
        "objectFormat": {"const": "sha1"},
        "objectIdHexLength": {"const": 40},
        "systemTrustLimitation": {"const": "GIT_EXECUTABLE_ONLY_TRANSITIVE_SYSTEM_DYLIB_CLOSURE_NOT_BOUND"},
        "transitiveClosureBound": {"const": false}
      }
    },
    "candidateAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateManifestPath",
        "candidateManifestRawSha256",
        "candidateSha256",
        "candidateSourceCommit",
        "candidateExecutionSha256",
        "candidatePackageTreeSha256",
        "candidateEvaluatorProducerFilesSha256",
        "storyManifestPath",
        "storyManifestRawSha256",
        "semanticVerificationAtClaimCreation",
        "semanticVerifierEntryPoint"
      ],
      "properties": {
        "candidateManifestPath": {
          "allOf": [
            {"$ref": "#/$defs/absolutePath"},
            {"type": "string", "pattern": "/inputs/candidate-manifest\\.json$"}
          ]
        },
        "candidateManifestRawSha256": {"const": "sha256:ca7826d38cae6e8a28e142e10e522e9c1425ba6abcec938182d9819ab0b2a816"},
        "candidateSha256": {"const": "sha256:373785e45a4485dfeded43466a5bff0f66de4a0c106c972262686e7a432cbdd6"},
        "candidateSourceCommit": {"const": "379e9800c81ca315976ab4c28d511664df6ab7ed"},
        "candidateExecutionSha256": {"const": "sha256:b28ebbfcca183fa5de6b2fd483b00d563906c731ff8696dc2e0c4d17861da4e1"},
        "candidatePackageTreeSha256": {"$ref": "#/$defs/sha256"},
        "candidateEvaluatorProducerFilesSha256": {"const": "sha256:c501608b8d47a35c32860ad1defe33a369cbc0313ab0f860952def52ef4e881c"},
        "storyManifestPath": {
          "allOf": [
            {"$ref": "#/$defs/absolutePath"},
            {"type": "string", "pattern": "/inputs/story-manifest\\.json$"}
          ]
        },
        "storyManifestRawSha256": {"const": "sha256:9072eef635220de62bf998088f88ea0ba86b2676f28085f16195f39712953180"},
        "semanticVerificationAtClaimCreation": {"const": true},
        "semanticVerifierEntryPoint": {"const": "verify_manifest_against_reconstructed_authority"}
      }
    },
    "targetedCheckpointRouteBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeKind",
        "candidateProfileId",
        "sessionProfileId",
        "availability",
        "executionAuthorized",
        "selector",
        "routeProfileSha256",
        "checkpoint",
        "checkpointSha256",
        "candidateProbeReceipt",
        "candidateProbeReceiptSha256",
        "futureEventStatusBar",
        "nativePresentationObserved",
        "nativeQualityObserved",
        "authoredReachabilityOnly",
        "scoreBearingEvidence",
        "routeDisposition",
        "routeBindingSha256"
      ],
      "properties": {
        "routeKind": {"const": "TARGETED_CHECKPOINT"},
        "candidateProfileId": {"const": "TARGETED_CHECKPOINT_DEBUG"},
        "sessionProfileId": {"const": "TARGETED_CHECKPOINT_DEBUG"},
        "availability": {"const": "AVAILABLE_DIAGNOSTIC_ONLY"},
        "executionAuthorized": {"const": true},
        "selector": {"enum": ["A1_NORMAL_READY", "A1_CONSTRUCTION_DUE_1M"]},
        "routeProfileSha256": {"$ref": "#/$defs/sha256"},
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "checkpointSha256": {"$ref": "#/$defs/sha256"},
        "candidateProbeReceipt": {"$ref": "#/$defs/positiveCheckpointProbe"},
        "candidateProbeReceiptSha256": {"$ref": "#/$defs/sha256"},
        "futureEventStatusBar": {"const": {
          "sourcePath": "game/realtime/ui/RealtimeEventRail.cs",
          "scenePath": "game/realtime/ui/RealtimeEventRail.tscn",
          "requiredSignals": [
            "CURRENT_TIME",
            "NEXT_EVENT_COUNTDOWN",
            "EVENT_START_END",
            "CONSTRUCTION_COMPLETION",
            "PROMISE_DECISION_DEADLINE",
            "THERMAL_TRIP_RECOVERY"
          ],
          "headlessWiringStatus": "EXACT_PACKAGE_TWO_CHECKPOINT_SCENE_LOAD_PASS",
          "nativeQualityStatus": "NOT_OBSERVED"
        }},
        "nativePresentationObserved": {"const": false},
        "nativeQualityObserved": {"const": false},
        "authoredReachabilityOnly": {"const": false},
        "scoreBearingEvidence": {"const": false},
        "routeDisposition": {"const": "DIAGNOSTIC_ATTEMPT_AUTHORIZED"},
        "routeBindingSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointId",
        "startMinute",
        "startCanonicalStateSha256",
        "commandReplaySchema",
        "commandReplaySha256",
        "commandCount",
        "expectedEndCanonicalStateSha256",
        "allowedInput",
        "allowedFrameCount",
        "framesPerSecond",
        "claimLabel"
      ],
      "properties": {
        "checkpointId": {"enum": ["A1_NORMAL_READY", "A1_CONSTRUCTION_DUE_1M"]},
        "startMinute": {"enum": [1020, 1259]},
        "startCanonicalStateSha256": {"$ref": "#/$defs/sha256"},
        "commandReplaySchema": {"const": "gridworks.targeted-live-command-replay.v1"},
        "commandReplaySha256": {"$ref": "#/$defs/sha256"},
        "commandCount": {"enum": [0, 3]},
        "expectedEndCanonicalStateSha256": {"$ref": "#/$defs/sha256"},
        "allowedInput": {"const": "HUD_SPEED_NORMAL"},
        "allowedFrameCount": {"const": 60},
        "framesPerSecond": {"const": 60},
        "claimLabel": {"enum": [
          "TARGETED_LIVE_CHECKPOINT_PASS:A1_NORMAL_READY",
          "TARGETED_LIVE_CHECKPOINT_PASS:A1_CONSTRUCTION_DUE_1M"
        ]}
      }
    },
    "positiveCheckpointProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probeId",
        "checkpointId",
        "userArguments",
        "inputFileCount",
        "inputTreeSha256",
        "inputCacheState",
        "exitCode",
        "readyClaimOccurrenceCount",
        "passClaimOccurrenceCount",
        "unexpectedTypedClaimCount",
        "readyClaimRawSha256",
        "passClaimRawSha256",
        "stdoutRawSha256",
        "stdoutByteLength",
        "stdoutUtf8",
        "stderrRawSha256",
        "stderrByteLength",
        "stderrUtf8",
        "logRawSha256",
        "logByteLength",
        "logUtf8",
        "readyClaim",
        "passClaim",
        "observedEphemeralEmptyDirectorySideEffects",
        "boundFileByteMutationCount",
        "nativePresentationObserved",
        "scoreBearingEvidence"
      ],
      "properties": {
        "probeId": {"enum": ["HEADLESS_A1_NORMAL_READY", "HEADLESS_A1_CONSTRUCTION_DUE_1M"]},
        "checkpointId": {"enum": ["A1_NORMAL_READY", "A1_CONSTRUCTION_DUE_1M"]},
        "userArguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "pattern": "^--checkpoint=A1_[A-Z0-9_]+$"}
        },
        "inputFileCount": {"const": 39},
        "inputTreeSha256": {"$ref": "#/$defs/sha256"},
        "inputCacheState": {"const": "COLD_NO_EDITOR_OR_UID_CACHE"},
        "exitCode": {"const": 0},
        "readyClaimOccurrenceCount": {"const": 1},
        "passClaimOccurrenceCount": {"const": 1},
        "unexpectedTypedClaimCount": {"const": 0},
        "readyClaimRawSha256": {"$ref": "#/$defs/sha256"},
        "passClaimRawSha256": {"$ref": "#/$defs/sha256"},
        "stdoutRawSha256": {"$ref": "#/$defs/sha256"},
        "stdoutByteLength": {"type": "integer", "minimum": 1},
        "stdoutUtf8": {"type": "string", "minLength": 1},
        "stderrRawSha256": {"$ref": "#/$defs/sha256"},
        "stderrByteLength": {"const": 0},
        "stderrUtf8": {"const": ""},
        "logRawSha256": {"$ref": "#/$defs/sha256"},
        "logByteLength": {"type": "integer", "minimum": 1},
        "logUtf8": {"type": "string", "minLength": 1},
        "readyClaim": {"$ref": "#/$defs/checkpointReadyClaim"},
        "passClaim": {"$ref": "#/$defs/checkpointPassClaim"},
        "observedEphemeralEmptyDirectorySideEffects": {"const": [
          "Godot",
          "Godot/app_userdata",
          "Godot/app_userdata/Gridworks"
        ]},
