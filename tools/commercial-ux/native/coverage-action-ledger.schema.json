{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/commercial-ux-coverage-action-ledger-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocol", "coverageActionLedgerSha256",
    "coverageActionLedgerSchemaSha256", "candidateManifestSha256",
    "executionArtifactSha256", "coverageRecipeSha256", "holdoutQueueSha256",
    "selectedRecipeId", "selectedRecipeSha256", "holdoutConsumptionReceiptSha256",
    "goldBindingManifestSha256", "holdoutRealization", "coverageRunId",
    "processTreeId", "userDataSha256", "journalBundleSha256", "clockDomainId",
    "episodeLedgerHashRule", "episodes"
  ],
  "properties": {
    "schemaVersion": {"const": "gridworks.commercial-ux.coverage-action-ledger.v1"},
    "protocol": {"const": "GRIDWORKS-COMMERCIAL-UX-v1.1"},
    "coverageActionLedgerSha256": {"$ref": "#/$defs/sha256"},
    "coverageActionLedgerSchemaSha256": {"$ref": "#/$defs/sha256"},
    "candidateManifestSha256": {"$ref": "#/$defs/sha256"},
    "executionArtifactSha256": {"$ref": "#/$defs/sha256"},
    "coverageRecipeSha256": {"$ref": "#/$defs/sha256"},
    "holdoutQueueSha256": {"$ref": "#/$defs/sha256"},
    "selectedRecipeId": {"pattern": "^(FORMATIVE-01|HOLDOUT-0[1-8])$"},
    "selectedRecipeSha256": {"$ref": "#/$defs/sha256"},
    "holdoutConsumptionReceiptSha256": {"$ref": "#/$defs/sha256"},
    "goldBindingManifestSha256": {"$ref": "#/$defs/sha256"},
    "holdoutRealization": {"$ref": "#/$defs/holdoutRealization"},
    "coverageRunId": {"type": "string", "minLength": 1, "maxLength": 200},
    "processTreeId": {"type": "string", "minLength": 1, "maxLength": 200},
    "userDataSha256": {"$ref": "#/$defs/sha256"},
    "journalBundleSha256": {"$ref": "#/$defs/sha256"},
    "clockDomainId": {"type": "string", "minLength": 1, "maxLength": 200},
    "episodeLedgerHashRule": {"const": "SHA256_OF_RFC8785_EPISODE_WITH_EPISODE_LEDGER_SHA256_NULL"},
    "episodes": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "prefixItems": [
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E00-TITLE"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E01-FIRST-LIGHT"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E02-SECOND-HEART"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E03-SECOND-SOURCE"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E04-NORTH-BANK"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E05-WHOSE-MARGIN"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E06-FLOOD"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E07-MAINTENANCE"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E08-FINALE"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E09-MID-RESUME"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E10-COMPLETE-RESUME"}}},
        {"$ref": "#/$defs/episode", "properties": {"episodeId": {"const": "E11-AUTHORED-TEXT"}}}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "holdoutRealization": {
      "type": "object", "additionalProperties": false,
      "required": [
        "missionPrototypeBits", "promiseBranchOrder",
        "actorArtifactPermutation", "coverageArtifactOrder"
      ],
      "properties": {
        "missionPrototypeBits": {"type": "string", "pattern": "^[01]{3}$"},
        "promiseBranchOrder": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["keep", "defer"]}
        },
        "actorArtifactPermutation": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 2}
        },
        "coverageArtifactOrder": {"enum": ["EPISODE_ASCENDING", "EPISODE_DESCENDING"]}
      }
    },
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "kind", "locator", "rawSha256", "byteLength", "mimeType"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["FRAME", "AUDIO", "ACTION_LEDGER", "VISIBLE_TEXT"]},
        "locator": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*(?:/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000/]+(?:/[^\\u0000/]+)*$",
          "maxLength": 500
        },
        "rawSha256": {"$ref": "#/$defs/sha256"},
        "byteLength": {"type": "integer", "minimum": 1, "maximum": 10737418240},
        "mimeType": {"enum": ["image/png", "audio/wav", "application/json"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "FRAME"}}, "required": ["kind"]}, "then": {"properties": {"mimeType": {"const": "image/png"}}}},
        {"if": {"properties": {"kind": {"const": "AUDIO"}}, "required": ["kind"]}, "then": {"properties": {"mimeType": {"const": "audio/wav"}}}},
        {"if": {"properties": {"kind": {"enum": ["ACTION_LEDGER", "VISIBLE_TEXT"]}}, "required": ["kind"]}, "then": {"properties": {"mimeType": {"const": "application/json"}}}}
      ]
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": [
        "traceRowId", "checkpoint", "checkpointBranchId", "actionOccurrenceId",
        "semanticActionKind", "prototypeSlot", "prototypeKind",
        "branchSequenceOrdinal", "branchDecision", "actionIndex",
        "deliveredMonotonicNanoseconds",
        "preStateSha256", "postStateSha256", "visibleFeedback", "audibleFeedback",
        "artifactRefs"
      ],
      "properties": {
        "traceRowId": {"type": "string", "pattern": "^TRACE-[0-9]{4}$"},
        "checkpoint": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,99}$"},
        "checkpointBranchId": {"enum": ["SHARED", "KEEP", "DEFER"]},
        "actionOccurrenceId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,119}$"},
        "semanticActionKind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,99}$"},
        "prototypeSlot": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
        "prototypeKind": {"type": ["string", "null"], "enum": ["STANDARD", "REINFORCED", null]},
        "branchSequenceOrdinal": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
        "branchDecision": {"type": ["string", "null"], "enum": ["keep", "defer", null]},
        "actionIndex": {"type": "integer", "minimum": 0, "maximum": 4096},
        "deliveredMonotonicNanoseconds": {
          "type": "integer", "minimum": 0, "maximum": 9223372036854775807
        },
        "preStateSha256": {"$ref": "#/$defs/sha256"},
        "postStateSha256": {"$ref": "#/$defs/sha256"},
        "visibleFeedback": {"type": "string", "minLength": 1, "maxLength": 1000},
        "audibleFeedback": {"type": "string", "maxLength": 1000},
        "artifactRefs": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifactRef"}
        }
      }
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["episodeId", "prefixId", "checkpointIds", "episodeLedgerSha256", "actions"],
      "properties": {
        "episodeId": {"pattern": "^E(0[0-9]|1[01])-[A-Z0-9-]+$"},
        "prefixId": {"type": "string", "pattern": "^PREFIX-[A-Z0-9-]+$"},
        "checkpointIds": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,99}$"}
        },
        "episodeLedgerSha256": {"$ref": "#/$defs/sha256"},
        "actions": {
          "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    }
  }
}
