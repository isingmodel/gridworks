[node name="HelpBody" type="Label" parent="Center/ShellPanel/Margin/Pages/HelpPage"]
layout_mode = 2
size_flags_vertical = 3
text = "지도\n• 마우스 왼쪽 클릭으로 격자점을 선택합니다.\n• 화살표로 한 칸, Shift와 화살표로 네 칸 이동합니다. Enter 또는 Space로 선택합니다.\n\n작업 패널\n• 변전소나 선로 도구를 고른 뒤 지도에서 계획합니다.\n• 발주 전에는 계획을 취소하거나 마지막 전신주를 되돌릴 수 있습니다.\n• 임무 결과 확인은 현재 공급 상태와 예고된 사고를 함께 판정합니다.\n\n메뉴와 저장\n• Esc로 일시정지 메뉴를 열거나 닫습니다.\n• 승인된 행동은 자동 저장됩니다."
autowrap_mode = 2

[node name="HelpBackButton" type="Button" parent="Center/ShellPanel/Margin/Pages/HelpPage"]
unique_name_in_owner = true
layout_mode = 2
text = "이전 화면으로"

