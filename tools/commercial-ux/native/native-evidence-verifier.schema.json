{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.invalid/schemas/commercial-ux-native-evidence-verifier-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "verifierRunId",
    "verifierSlot",
    "model",
    "reasoningEffort",
    "promptTemplateSha256",
    "verifierSchemaSha256",
    "verificationInputSchemaSha256",
    "verificationInputSha256",
    "evidenceSetSha256",
    "opaqueJudgePanelSha256",
    "observations"
  ],
  "properties": {
    "schemaVersion": {"const": "gridworks.commercial-ux.native-evidence-verification.v1"},
    "protocol": {
      "const": "GRIDWORKS-COMMERCIAL-UX-v1.1"
    },
    "verifierRunId": {"type": "string", "minLength": 1, "maxLength": 200},
    "verifierSlot": {"const": "SOL-ULTRA"},
    "model": {"const": "gpt-5.6-sol"},
    "reasoningEffort": {"const": "ultra"},
    "promptTemplateSha256": {"$ref": "#/$defs/sha256"},
    "verifierSchemaSha256": {"$ref": "#/$defs/sha256"},
    "verificationInputSchemaSha256": {"$ref": "#/$defs/sha256"},
    "verificationInputSha256": {"$ref": "#/$defs/sha256"},
    "evidenceSetSha256": {"$ref": "#/$defs/sha256"},
    "opaqueJudgePanelSha256": {"$ref": "#/$defs/sha256"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 768,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/verification"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anonymousArtifactId", "artifactId", "locator"],
      "properties": {
        "anonymousArtifactId": {"type": "string", "pattern": "^ARTIFACT-[A-D]$"},
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 200},
        "locator": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "verdict", "citedSources", "rationale"],
      "properties": {
        "observationId": {"type": "string", "pattern": "^OBS-[0-9]{4}$"},
        "verdict": {"enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED"]},
        "citedSources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
