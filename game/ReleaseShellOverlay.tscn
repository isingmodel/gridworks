[node name="HelpBody" type="Label" parent="Center/ShellPanel/Margin/Pages/HelpPage"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 16
text = "지도 조작\n• 마우스 왼쪽 버튼으로 격자를 선택합니다.\n• 화살표 키로 한 칸, Shift 키와 화살표 키로 네 칸 이동합니다. Enter 키 또는 Space 키로 선택합니다.\n\n공사 계획\n• 변전소나 선로를 선택한 뒤 지도에서 위치와 경로를 정합니다.\n• 발주 전에는 계획을 취소하거나 한 단계 되돌릴 수 있습니다.\n• ‘예고 상황 보기’로 사용할 수 없는 설비와 우회 경로를 먼저 확인할 수 있습니다.\n• ‘운영 계획 점검’을 누르면 평상시와 예고 상황의 공급 상태를 확인합니다.\n• 이 게임은 연결과 정격을 다루는 계획 모델이며 실제 전력망의 안전 설계나 운전 판단을 대신하지 않습니다.\n\n메뉴와 저장\n• Esc 키로 일시정지 메뉴를 열거나 닫습니다.\n• 설비 배치, 선로 연결과 공사 진행은 자동으로 저장됩니다.\n• 해법을 다시 설계해야 할 때는 이전 임무 시작으로 돌아갈 수 있습니다."
autowrap_mode = 2

