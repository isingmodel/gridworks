    "criticalIncident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incidentKey", "severity", "status", "activeCap", "evidenceRefs"],
      "properties": {
        "incidentKey": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+/[A-Z0-9_-]+/[A-Z0-9_-]+/[A-Z0-9_-]+$"
        },
        "severity": {"enum": ["P0", "P1", "P2"]},
        "status": {"enum": ["VERIFIED", "UNRESOLVED"]},
        "activeCap": {"enum": [100, 79, 69, 49]},
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "differenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "cellIds", "incidentKeys", "observation", "boundedChange"],
      "properties": {
        "priority": {"enum": ["P0", "P1", "P2"]},
        "cellIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 39,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[JTHICAPVRLK][1-5]$"}
        },
        "incidentKeys": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]+/[A-Z0-9_-]+/[A-Z0-9_-]+/[A-Z0-9_-]+$"
          }
        },
        "observation": {"type": "string", "minLength": 1, "maxLength": 1600},
        "boundedChange": {"type": "string", "minLength": 1, "maxLength": 1200}
      }
    },
    "differenceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "openP0", "openP1", "openP2"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 117,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/differenceItem"}
        },
        "openP0": {"type": "integer", "minimum": 0, "maximum": 117},
        "openP1": {"type": "integer", "minimum": 0, "maximum": 117},
        "openP2": {"type": "integer", "minimum": 0, "maximum": 117}
      }
    },
