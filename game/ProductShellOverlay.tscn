[node name="HelpBody" type="Label" parent="Center/ShellPanel/Margin/Pages/HelpPage"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 15
text = "지도\n• 마우스를 움직여 배치 결과를 미리 보고 왼쪽 클릭으로 선택합니다.\n• 키보드는 화살표로 격자 커서를 움직이고 Enter 또는 Space로 선택합니다.\n\n작업 패널\n• Tab과 Shift+Tab으로 버튼을 이동하고 Enter 또는 Space로 실행합니다.\n• 취소·되돌리기는 발주 전 초안만 바꿉니다.\n• 발주 뒤에는 완공까지 진행해야 설비가 통전됩니다.\n\n메뉴와 저장\n• Esc로 일시정지 메뉴를 열거나 닫습니다.\n• 승인된 행동은 단일 저장에 자동으로 기록됩니다.\n• ‘저장하고 종료’는 저장 성공 뒤 게임을 종료합니다."
autowrap_mode = 2

